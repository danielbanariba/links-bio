---
// Navbar: sticky top bar with the personal {daniel_banariba}; brand logo
// (ported faithfully from links_bio/components/metal/metal_navbar.py) + page links.
// Logo colors come from links_bio/styles/colors.py LogoColor enum:
//   { }  -> PARENTESIS #f1d700
//   word -> PALABRAS   #c398f4
//   ;    -> PUNTO_Y_COMA #bbbbbb
// font: DinaRemasterII (Font.LOGO) via --font-logo.
//
// Used by the bio (/) and the 404 only. The Metal Archive pages have their own
// shell (ArchiveChrome.astro: sidebar, top bar, phone tab bar).
---
<a href="#main" class="skip-link">Skip to content</a>
<header class="navbar">
  <a href="/" class="navbar__brand" aria-label="daniel_banariba">
    <span class="logo-paren">{'{'}</span><span class="logo-word">daniel_banariba</span><span class="logo-paren">{'}'}</span><span class="logo-semi">;</span>
  </a>
  <nav class="navbar__links" aria-label="Site">
    <a href="/">Bio</a>
    <a href="/metal-archive">Archive</a>
    <a href="/metal-archive/browse">Browse</a>
    <a href="/metal-archive/submit">Submit</a>
    <!-- Promote was reachable ONLY from the mobile tab bar; desktop visitors had
         no path to it at all. It is the page that generates revenue, so it
         belongs in both navigations. -->
    <a href="/metal-archive/promo">Promote</a>
    <a href="/metal-archive/newsletter">Newsletter</a>
    <!-- F7 (Oct 2026 UI audit): below 560px the label span is display:none
         (hidden content is excluded from accessible-name computation), and the
         svg is aria-hidden, so the button had NO accessible name on mobile.
         aria-label fixes it on every viewport. -->
    <button id="navbar-surprise" class="navbar__surprise" type="button" aria-label="Surprise me">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <circle cx="8.5" cy="8.5" r="1.2" fill="currentColor"></circle>
        <circle cx="15.5" cy="8.5" r="1.2" fill="currentColor"></circle>
        <circle cx="8.5" cy="15.5" r="1.2" fill="currentColor"></circle>
        <circle cx="15.5" cy="15.5" r="1.2" fill="currentColor"></circle>
        <circle cx="12" cy="12" r="1.2" fill="currentColor"></circle>
      </svg>
      <span class="navbar__surprise-label">Surprise me</span>
    </button>
  </nav>
</header>

<script>
  // Go to `url`. On a ClientRouter page (the archive) this is a client-side
  // navigation, so the persisted Player island keeps playing; a full page load
  // would destroy it. Pages without ClientRouter (the bio) load the page as before.
  async function goTo(url: string) {
    let navigate: ((to: string) => unknown) | null = null;
    if (document.querySelector('[name="astro-view-transitions-enabled"]')) {
      try {
        navigate = (await import('astro:transitions/client')).navigate;
      } catch {
        navigate = null;
      }
    }
    if (navigate) navigate(url);
    else window.location.href = url;
  }

  // Surprise Me: navigate to a random album. The album id list is inlined on
  // the home page; on other pages we fall back to a small fetch of the browse
  // index (already cached on browse) to pick a random id.
  //
  // With ClientRouter the navbar markup is re-rendered on every navigation and
  // this <script> does NOT re-execute, so we (re-)bind the handler on each
  // astro:page-load. A per-element flag prevents double-binding on the first
  // load (where both the initial run and astro:page-load fire).
  function bindNavbarSurprise() {
    const btn = document.getElementById('navbar-surprise');
    if (!btn || (btn as any).__bound) return;
    (btn as any).__bound = true;
    btn.addEventListener('click', async function () {
      // Prefer an inlined id list if the page provided one (home page).
      const inlined = (window as any).__albumIds as number[] | undefined;
      if (inlined && inlined.length) {
        const id = inlined[Math.floor(Math.random() * inlined.length)];
        goTo('/metal-archive/album/' + id);
        return;
      }
      try {
        const res = await fetch('/browse-index.json');
        const data = await res.json();
        if (Array.isArray(data) && data.length) {
          const pick = data[Math.floor(Math.random() * data.length)];
          if (pick && pick.id != null) {
            goTo('/metal-archive/album/' + pick.id);
          }
        }
      } catch {
        goTo('/metal-archive/browse');
      }
    });
  }
  // Bind immediately for pages WITHOUT ClientRouter (the bio, where
  // astro:page-load never fires) and on the initial DOM; re-bind on every
  // client-side navigation for metal-archive pages. The __bound guard makes the
  // overlap on the first metal-archive load a no-op.
  bindNavbarSurprise();
  document.addEventListener('astro:page-load', bindNavbarSurprise);

  // F7 skip-link (#7): move focus to <main id="main"> after a CLIENT-SIDE
  // navigation swap only -- never on the initial page load, which would
  // steal focus from wherever the browser/user put it (e.g. a fragment
  // link, or just the top of the page as usual). astro:page-load fires on
  // BOTH the initial load and every navigation, so it can't be used here;
  // astro:after-swap fires only when ClientRouter actually swaps the DOM
  // for a same-session navigation, which is exactly the "page changed under
  // you without a real reload" case a skip link exists for.
  document.addEventListener('astro:after-swap', () => {
    const main = document.getElementById('main');
    // R3-001: preventScroll so focusing #main never moves the viewport --
    // ClientRouter's own scroll handling (including back/forward restoring a
    // prior scroll position) stays in control; focus must not fight it.
    main?.focus({ preventScroll: true });
  });

  // F10 (Oct 2026 UI audit): width:100vw full-bleed sections (.stage on the
  // album page) overflow the real viewport by exactly the vertical
  // scrollbar's width, because `vw` is computed from the full window width
  // while the document's own clientWidth already excludes the scrollbar — a
  // well-known CSS gap with no scrollbar-aware unit to fix it in pure CSS.
  // Measuring it once in JS and exposing it as --scrollbar-w lets .stage
  // subtract it from its width/margins instead of clipping page content.
  // This script runs once per full page load (not per client-side nav), so
  // the listeners below are registered exactly once; re-measuring on resize
  // and on astro:page-load covers both a resized window and a navigation to
  // a page tall/short enough to gain or lose the scrollbar.
  function setScrollbarWidthVar() {
    const w = Math.max(window.innerWidth - document.documentElement.clientWidth, 0);
    document.documentElement.style.setProperty('--scrollbar-w', w + 'px');
  }
  setScrollbarWidthVar();
  window.addEventListener('resize', setScrollbarWidthVar);
  document.addEventListener('astro:page-load', setScrollbarWidthVar);
</script>
