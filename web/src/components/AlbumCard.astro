---
// AlbumCard, as in the prototype: a square cover that IS the ▶, and under it the
// album title and the band, which link to the album page.
//   - The cover is a <button> carrying the Player's data attributes
//     (lib/cardPlay.ts): one tap plays the album, queued with the cards of its
//     row or grid ([data-queue]). Its name says what it does ("Play X by Y"); the
//     Player flips it to "Pause ..." and the glyph to ⏸ while that album plays.
//     The ▶ disc shows on hover and focus, and stays while the album plays.
//   - An album with no video has nothing to play: its cover is a second link to
//     the album page, hidden from assistive tech and the tab order (the text link
//     right under it is the same destination).
//   - The cover is drawn by CoverArt: a square crop fills it, a YouTube frame is
//     letterboxed whole over a blurred copy, never centre-cropped.
//   - The title drops the "(Full Álbum)" suffix (lib/title.ts), display only.
// `livePlaceholder` draws a flat tile with a microphone instead of the image
// (Daniel's own live sets).
// The same markup is built by islands/Search.tsx for the Browse results.
import type { Card } from '../lib/types.js';
import { playAttrs } from '../lib/cardPlay.js';
import { displayTitle } from '../lib/title.js';
import { GLYPH_PLAY } from '../lib/icons.js';
import CoverArt from './CoverArt.astro';
import Icon from './Icon.astro';

interface Props {
  album: Card;
  loading?: 'lazy' | 'eager';
  livePlaceholder?: boolean;
}

const { album, loading = 'lazy', livePlaceholder = false } = Astro.props;
const href = `/metal-archive/album/${album.id}`;
const title = displayTitle(album.album_title);
const attrs = await playAttrs(album);
const src = album.cover || album.thumb;
---
<div class="ma-card">
  {attrs
    ? (
      <button type="button" class="ma-card__cover" aria-label={`Play ${title} by ${album.band_name}`} {...attrs}>
        {livePlaceholder
          ? <span class="ma-art ma-art--live"><Icon name="mic" /></span>
          : <CoverArt src={src} loading={loading} />}
        <span class="ma-card__play" aria-hidden="true">
          <svg data-glyph viewBox="0 0 24 24" fill="currentColor"><path d={GLYPH_PLAY} /></svg>
        </span>
      </button>
    )
    : (
      <a class="ma-card__cover" href={href} tabindex="-1" aria-hidden="true">
        {livePlaceholder
          ? <span class="ma-art ma-art--live"><Icon name="mic" /></span>
          : <CoverArt src={src} loading={loading} />}
      </a>
    )}
  <a class="ma-card__meta" href={href}>
    <span class="ma-card__title">{title}</span>
    <span class="ma-card__band">{album.band_name}</span>
  </a>
</div>
