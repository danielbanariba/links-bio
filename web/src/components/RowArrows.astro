---
// Prev/next arrows for a horizontal cover row. They live in the row's header, inside
// the same <section> as the .carousel-row they scroll. The script below wires every
// instance on whatever page renders it, so no page needs script of its own. Pointer
// devices only (CSS): touch swipes.
interface Props { title: string }
const { title } = Astro.props;
---

<span class="row-arrows">
  <button type="button" class="row-arrow" data-row-scroll="-1" aria-label={`Scroll ${title} left`}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>
  </button>
  <button type="button" class="row-arrow" data-row-scroll="1" aria-label={`Scroll ${title} right`}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
  </button>
</span>

<script>
  // With ClientRouter this module runs once per document, so the rows of a page that
  // arrives later are bound on astro:page-load (which also fires on the first load).
  // The extra direct call covers a navigation that runs this script after that event
  // has already fired. A WeakSet makes the binding idempotent.
  const bound = new WeakSet<Element>();
  const syncOf = new WeakMap<Element, () => void>();

  function bindArrows(arrows: HTMLElement) {
    const row = arrows.closest('section')?.querySelector<HTMLElement>('.carousel-row');
    if (!row || bound.has(arrows)) return;
    bound.add(arrows);

    const buttons = arrows.querySelectorAll<HTMLButtonElement>('[data-row-scroll]');
    const sync = () => {
      const max = row.scrollWidth - row.clientWidth;
      buttons.forEach((b) => {
        const atEnd = b.dataset.rowScroll === '-1' ? row.scrollLeft <= 1 : max - row.scrollLeft <= 1;
        b.disabled = atEnd;
      });
    };

    arrows.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('[data-row-scroll]');
      if (!btn) return;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      // About one visible width, keeping a little of the last card for context.
      row.scrollBy({ left: Number(btn.dataset.rowScroll) * row.clientWidth * 0.9, behavior: reduce ? 'auto' : 'smooth' });
    });
    row.addEventListener('scroll', sync, { passive: true });
    syncOf.set(arrows, sync);
    sync();
  }

  function bindAll() {
    document.querySelectorAll<HTMLElement>('.row-arrows').forEach(bindArrows);
  }
  window.addEventListener('resize', () => {
    document.querySelectorAll('.row-arrows').forEach((el) => syncOf.get(el)?.());
  });
  document.addEventListener('astro:page-load', bindAll);
  bindAll();
</script>
