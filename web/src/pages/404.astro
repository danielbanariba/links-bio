---
// Custom 404 — reuses the site's own nav/branding instead of Vercel's bare
// generic platform error. Astro's `output: 'static'` convention writes this
// page to the literal "404.html" Vercel's static hosting looks for as the
// catch-all not-found page, so ONE page here covers both the bio (/) and
// every /metal-archive/* path (there is no per-folder 404 in static hosting).
//
// It is built in the dark room too (the archive bar, via `room`; no player). The way back
// names all three places a visitor may have been headed: the archive, its search, and the bio,
// and the shelf below shows what is new in the archive, so a mistyped bio URL has a way on too.
import { getLatestUploads } from '../lib/db.js';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ArchiveHead from '../components/ArchiveHead.astro';
import PageHead from '../components/PageHead.astro';
import Reveal from '../components/Reveal.astro';
import Carousel from '../components/Carousel.astro';
import '../styles/global.css';

const latest = getLatestUploads(8);

// The field of the head: a warm neutral, mixed down into the ground by PageHead (as Browse).
const HEAD_COLOR = '#8c8478';

const pageTitle = 'Page not found | Daniel Banariba';
const canonical = 'https://danielbanariba.com/404';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content="The page you're looking for doesn't exist, or it may have moved." />
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={canonical} />
  <ArchiveHead />
</head>
<body class="ma">
  <Reveal />
  <Navbar room />

  <main id="main" tabindex="-1">
    <PageHead title="Page not found" color={HEAD_COLOR} split>
      <div class="page-head__side">
        <p class="page-head__lead rise" style="--i:1">The address may be mistyped, or the page may have moved.</p>
        <div class="fm-actions">
          <a class="btn btn--primary rise" style="--i:2" href="/metal-archive">Go to the archive</a>
          <a class="btn btn--secondary rise" style="--i:3" href="/metal-archive/browse">Search the archive</a>
          <a class="btn btn--secondary rise" style="--i:4" href="/">Daniel's site</a>
        </div>
      </div>
    </PageHead>

    <Carousel id="new" title="Recently added" albums={latest} href="/metal-archive/browse" hrefLabel="See all" />
  </main>

  <Footer />
</body>
</html>
