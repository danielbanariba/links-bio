---
// Browse page, "the dark room" (premium redesign, 2026): static shell that writes
// browse-index.json at build time, renders an initial server-side wall of the newest albums
// (SEO + no blank page before JS), then mounts the Search island which owns the controls, the
// count and the result.
//
// The head is the shared PageHead (a field of its own colour under the top bar, the name in the
// display face), bare: Browse is a tool, so there is no lit cover beside the name.
import { writeFileSync, mkdirSync } from 'node:fs';
import { resolve } from 'node:path';
import { ClientRouter } from 'astro:transitions';
import { getBrowseIndex, getAllGenres, getAllCountries, getAllYears, isLiveRecording } from '../../lib/db.js';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ArchiveHead from '../../components/ArchiveHead.astro';
import PageHead from '../../components/PageHead.astro';
import Reveal from '../../components/Reveal.astro';
import Search, { PAGE_SIZE } from '../../islands/Search.tsx';
import '../../styles/global.css';

// ─── Build-time index ─────────────────────────────────────────────────────────
// The browse index is written to two locations:
//   1. public/browse-index.json — Astro copies public/ to dist/ during build,
//      but public files are copied in the pre-render phase. Since Astro copies
//      public/ AFTER the JS bundle phase, the file written here is available
//      for the NEXT incremental build (warms the cache) AND is picked up by
//      the vercel adapter copy step.
//   2. .vercel/output/static/browse-index.json — direct write so the current
//      build ships the file without relying on build-phase ordering.
// The fetch URL is /browse-index.json (no Astro base; Vercel serves the static
// dir at the site root).
const index = getBrowseIndex();
const indexJson = JSON.stringify(index);
const cwd = process.cwd();

// Write to public/ (next-build warmth + Astro copy cycle).
const publicDir = resolve(cwd, 'public');
mkdirSync(publicDir, { recursive: true });
writeFileSync(resolve(publicDir, 'browse-index.json'), indexJson, 'utf-8');

// Write directly into the Vercel static output so this build ships it.
// dist/ is the intermediate; .vercel/output/static/ is what Vercel deploys.
for (const target of [
  resolve(cwd, 'dist', 'browse-index.json'),
  resolve(cwd, '.vercel', 'output', 'static', 'browse-index.json'),
]) {
  try {
    mkdirSync(resolve(target, '..'), { recursive: true });
    writeFileSync(target, indexJson, 'utf-8');
  } catch {
    // directory may not exist yet on the very first cold build — public/ copy is the fallback
  }
}

// ─── Initial static wall: the newest page of albums, the order the island opens in
// ("Newest first" sorts by id, higher id = uploaded later).
// Live recordings (Daniel's own live sets) are left out of this first list so official albums
// lead; they remain in the full index JSON and stay searchable.
const officialIndex = index.filter((a) => !isLiveRecording(a.album_title));
const initial = officialIndex.slice().sort((a, b) => b.id - a.id).slice(0, PAGE_SIZE);

// ─── Filter option lists for the dropdowns (passed as props to avoid redundant
//     JS parsing of the full index just to build option arrays on mount).
const genres = getAllGenres().map((f) => f.value);
const countries = getAllCountries().map((f) => f.value);
const years = getAllYears().map((f) => String(f.value));

const totalCount = index.length;

// The field of the head: a warm neutral, mixed down into the ground by PageHead.
const HEAD_COLOR = '#8c8478';

const pageTitle = 'Browse albums | Metal Archive';
const metaDesc = `Browse ${totalCount} underground metal albums. Filter by genre, country, year and release type.`;
const canonical = 'https://danielbanariba.com/metal-archive/browse';
const ogImage = officialIndex[0]?.thumb || undefined;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDesc} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDesc} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDesc} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <link rel="canonical" href={canonical} />
  <ArchiveHead />
  <ClientRouter />
</head>
<body class="ma">
  <Reveal />
  <Navbar />

  <main id="main" tabindex="-1">
    <PageHead title="Browse albums" color={HEAD_COLOR} split>
      <p class="page-head__lead rise" style="--i:1">Every record in the archive, by band, title, genre or country.</p>
    </PageHead>

    <!--
      Search island owns ALL interactivity.
      The `initial` prop gives it the first-page data without an extra fetch,
      so cards are visible before the full index download completes.
      `client:load` hydrates immediately (search is the primary purpose of
      this page — no point deferring).
    -->
    <Search
      client:load
      genres={genres}
      countries={countries}
      years={years}
      totalCount={totalCount}
      initial={initial}
    />

    <!--
      No-JS fallback: the island's server-rendered wall is already on the page; the controls and
      "Show more" need script (global.css hides them without it), so say so.
    -->
    <noscript>
      <p class="finder__nojs">Search and filters need JavaScript. The newest albums are listed above.</p>
    </noscript>
  </main>

  <Footer />
</body>
</html>
