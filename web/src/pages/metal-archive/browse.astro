---
// Browse page — static shell that writes browse-index.json at build time,
// renders an initial server-side grid of the first 24 albums (SEO + no blank
// page before JS), then mounts the Search island which owns all interactivity.
import { writeFileSync, mkdirSync } from 'node:fs';
import { resolve } from 'node:path';
import { ClientRouter } from 'astro:transitions';
import { getBrowseIndex, getAllGenres, getAllCountries, getAllYears, getGenreFacetGroups, groupFacetsBySlug, isLiveRecording } from '../../lib/db.js';
import { countryFlag, countryLabel, genreLabel } from '../../lib/labels.js';
import { encodeAccent } from '../../lib/accent.js';
import { getAlbumAccent } from '../../lib/vibrant.js';
import ArchiveChrome from '../../components/ArchiveChrome.astro';
import Footer from '../../components/Footer.astro';
import Search from '../../islands/Search.tsx';
import '../../styles/global.css';
import '../../styles/archive.css';

// ─── Build-time index ─────────────────────────────────────────────────────────
// The browse index is written to two locations:
//   1. public/browse-index.json — Astro copies public/ to dist/ during build,
//      but public files are copied in the pre-render phase. Since Astro copies
//      public/ AFTER the JS bundle phase, the file written here is available
//      for the NEXT incremental build (warms the cache) AND is picked up by
//      the vercel adapter copy step.
//   2. .vercel/output/static/browse-index.json — direct write so the current
//      build ships the file without relying on build-phase ordering.
// The fetch URL is /browse-index.json (no Astro base; Vercel serves the static
// dir at the site root).
// Each playable entry carries its ▶'s accent tokens (encoded, lib/accent.ts), so
// the Player paints the album's colour without extracting anything at runtime.
// One album at a time: a cold colour cache decodes ~2,700 crops here.
const index = getBrowseIndex();
for (const entry of index) {
  if (!entry.youtube_video_id) continue;
  const accent = await getAlbumAccent({ videoId: entry.youtube_video_id, thumbUrl: entry.thumb });
  if (accent) entry.accent = encodeAccent(accent);
}
const indexJson = JSON.stringify(index);
const cwd = process.cwd();

// Write to public/ (next-build warmth + Astro copy cycle).
const publicDir = resolve(cwd, 'public');
mkdirSync(publicDir, { recursive: true });
writeFileSync(resolve(publicDir, 'browse-index.json'), indexJson, 'utf-8');

// Write directly into the Vercel static output so this build ships it.
// dist/ is the intermediate; .vercel/output/static/ is what Vercel deploys.
for (const target of [
  resolve(cwd, 'dist', 'browse-index.json'),
  resolve(cwd, '.vercel', 'output', 'static', 'browse-index.json'),
]) {
  try {
    mkdirSync(resolve(target, '..'), { recursive: true });
    writeFileSync(target, indexJson, 'utf-8');
  } catch {
    // directory may not exist yet on the very first cold build — public/ copy is the fallback
  }
}

// ─── Initial static grid (first 24, by band_name ASC — same default as index).
// Live recordings (Daniel's own live sets) are excluded from the DEFAULT browse
// view so official albums lead; they remain in the full index JSON and stay
// searchable, just not surfaced as part of the unfiltered default grid.
const officialIndex = index.filter((a) => !isLiveRecording(a.album_title));
const initial = officialIndex.slice(0, 24);

// ─── Filter option lists for the dropdowns (passed as props to avoid redundant
//     JS parsing of the full index just to build option arrays on mount).
const genres = getAllGenres().map((f) => f.value);
const countries = getAllCountries().map((f) => f.value);
const years = getAllYears().map((f) => String(f.value));

const totalCount = index.length;

// Genres and Countries (the shell's sidebar links here, #genres / #countries):
// one link per facet page, biggest first, with the same slugs as getStaticPaths.
const genreLinks = getGenreFacetGroups()
  .sort((a, b) => b.count - a.count)
  .map((g) => ({ href: `/metal-archive/genre/${g.slug}`, label: genreLabel(g.label), count: g.count }));
const countryLinks = groupFacetsBySlug(getAllCountries())
  .sort((a, b) => b.count - a.count)
  .map((g) => ({ href: `/metal-archive/country/${g.slug}`, label: countryLabel(g.label), flag: countryFlag(g.label), count: g.count }));

const pageTitle = 'Browse albums | Metal Archive';
const metaDesc = `Browse ${totalCount} underground metal albums. Filter by genre, country, year and release type.`;
const canonical = 'https://danielbanariba.com/metal-archive/browse';
const ogImage = initial[0]?.thumb || undefined;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDesc} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDesc} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDesc} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <link rel="canonical" href={canonical} />
  <ClientRouter />
</head>
<body class="ma-shell">
  <ArchiveChrome />

  <main class="browse-page" id="main" tabindex="-1">
    <div class="browse-header">
      <h1 class="browse-title">Browse albums</h1>
      <p class="browse-subtitle">{totalCount} albums in the archive</p>
    </div>

    <!--
      Search island owns ALL interactivity.
      The `initial` prop gives it the first-page data without an extra fetch,
      so cards are visible before the full index download completes.
      `client:load` hydrates immediately (search is the primary purpose of
      this page — no point deferring).
    -->
    <Search
      client:load
      genres={genres}
      countries={countries}
      years={years}
      totalCount={totalCount}
      initial={initial}
    />

    <!--
      No-JS fallback: a static grid that mirrors what the island will render.
      Hidden once the island takes over (the island replaces .browse-static).
    -->
    <noscript>
      <div class="album-grid browse-static">
        {initial.map((a) => (
          <a class="album-card" href={`/metal-archive/album/${a.id}`}>
            <div class="album-card__art">
              {a.thumb
                ? <img class="album-card__cover" src={a.thumb} alt={`${a.band_name} — ${a.album_title}`} loading="lazy" decoding="async" width="400" height="400" />
                : <div class="album-card__cover album-card__cover--empty" aria-hidden="true" />
              }
            </div>
            <div class="album-card__body">
              <div class="album-card__album">{a.album_title}</div>
              <div class="album-card__band">{a.band_name}</div>
            </div>
          </a>
        ))}
      </div>
    </noscript>

    <section class="ma-facets" id="genres" aria-labelledby="genres-h">
      <h2 class="ma-facets__title" id="genres-h">Genres</h2>
      <ul class="ma-pills">
        {genreLinks.map((g) => (
          <li><a class="ma-pill" href={g.href}>{g.label}<small>{g.count}</small></a></li>
        ))}
      </ul>
    </section>
    <section class="ma-facets" id="countries" aria-labelledby="countries-h">
      <h2 class="ma-facets__title" id="countries-h">Countries</h2>
      <ul class="ma-pills">
        {countryLinks.map((c) => (
          <li><a class="ma-pill" href={c.href}>{c.flag && <span aria-hidden="true">{c.flag}</span>}{c.label}<small>{c.count}</small></a></li>
        ))}
      </ul>
    </section>
  </main>

  <Footer />
</body>
</html>
