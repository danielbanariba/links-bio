---
// Browse page: the archive's search, as in the prototype's search screen. It
// writes browse-index.json at build time and mounts the Search island, which
// owns the field and its results (islands/Search.tsx). Under it, the page's own
// HTML is the empty state: a tile per big genre and country (the sidebar's
// Genres and Countries land on #genres and #countries), the rest as links. The
// island hides that while it shows results or a filtered list (archive.css).
import { writeFileSync, mkdirSync } from 'node:fs';
import { resolve } from 'node:path';
import { ClientRouter } from 'astro:transitions';
import { getBrowseIndex, getAllCountries, getGenreFacetGroups, groupFacetsBySlug, getFacetTiles, isLiveRecording } from '../../lib/db.js';
import { countryFlag, countryLabel, genreLabel } from '../../lib/labels.js';
import { encodeAccent } from '../../lib/accent.js';
import { getAlbumAccent } from '../../lib/vibrant.js';
import ArchiveChrome from '../../components/ArchiveChrome.astro';
import FacetTile from '../../components/FacetTile.astro';
import Footer from '../../components/Footer.astro';
import Search from '../../islands/Search.tsx';
import '../../styles/global.css';
import '../../styles/archive.css';

// ─── Build-time index ─────────────────────────────────────────────────────────
// The browse index is written to two locations:
//   1. public/browse-index.json — Astro copies public/ to dist/ during build,
//      but public files are copied in the pre-render phase. Since Astro copies
//      public/ AFTER the JS bundle phase, the file written here is available
//      for the NEXT incremental build (warms the cache) AND is picked up by
//      the vercel adapter copy step.
//   2. .vercel/output/static/browse-index.json — direct write so the current
//      build ships the file without relying on build-phase ordering.
// The fetch URL is /browse-index.json (no Astro base; Vercel serves the static
// dir at the site root).
// Each playable entry carries its ▶'s accent tokens (encoded, lib/accent.ts), so
// the Player paints the album's colour without extracting anything at runtime.
// One album at a time: a cold colour cache decodes ~2,700 crops here.
const index = getBrowseIndex();
for (const entry of index) {
  if (!entry.youtube_video_id) continue;
  const accent = await getAlbumAccent({ videoId: entry.youtube_video_id, thumbUrl: entry.thumb });
  if (accent) entry.accent = encodeAccent(accent);
}
const indexJson = JSON.stringify(index);
const cwd = process.cwd();

// Write to public/ (next-build warmth + Astro copy cycle).
const publicDir = resolve(cwd, 'public');
mkdirSync(publicDir, { recursive: true });
writeFileSync(resolve(publicDir, 'browse-index.json'), indexJson, 'utf-8');

// Write directly into the Vercel static output so this build ships it.
// dist/ is the intermediate; .vercel/output/static/ is what Vercel deploys.
for (const target of [
  resolve(cwd, 'dist', 'browse-index.json'),
  resolve(cwd, '.vercel', 'output', 'static', 'browse-index.json'),
]) {
  try {
    mkdirSync(resolve(target, '..'), { recursive: true });
    writeFileSync(target, indexJson, 'utf-8');
  } catch {
    // directory may not exist yet on the very first cold build — public/ copy is the fallback
  }
}

const totalCount = index.length;

// ─── Empty state: tiles for the biggest facets, links for the rest ───────────
// The tiles take the same ranks and colours as the home's rows; the links list
// every other facet page (the catch-all "Metal" and the unknown-genre page
// included), biggest first, with the same slugs as getStaticPaths.
const TILES = 18;
const genreTiles = getFacetTiles('genre', TILES);
const countryTiles = getFacetTiles('country', TILES);
const tiled = (list: { slug: string }[]) => new Set(list.map((t) => t.slug));
const genreTiled = tiled(genreTiles);
const countryTiled = tiled(countryTiles);
const moreGenres = getGenreFacetGroups()
  .filter((g) => !genreTiled.has(g.slug))
  .sort((a, b) => b.count - a.count)
  .map((g) => ({ href: `/metal-archive/genre/${g.slug}`, label: genreLabel(g.label), count: g.count }));
const moreCountries = groupFacetsBySlug(getAllCountries())
  .filter((g) => !countryTiled.has(g.slug))
  .sort((a, b) => b.count - a.count)
  .map((g) => ({ href: `/metal-archive/country/${g.slug}`, label: countryLabel(g.label), flag: countryFlag(g.label), count: g.count }));

const pageTitle = 'Search | Metal Archive';
const metaDesc = `Search ${totalCount} underground metal albums by band, album, genre or country.`;
const canonical = 'https://danielbanariba.com/metal-archive/browse';
const ogImage = index.find((a) => !isLiveRecording(a.album_title))?.thumb || undefined;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDesc} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDesc} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDesc} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  <link rel="canonical" href={canonical} />
  <ClientRouter />
</head>
<body class="ma-shell ma">
  <ArchiveChrome />

  <main class="ma-searchpage" id="main" tabindex="-1">
    <Search client:load total={totalCount} />

    <div class="ma-browse-empty">
      <section class="ma-browse" id="genres" aria-labelledby="genres-h">
        <h2 class="ma-sect__title" id="genres-h">Genres</h2>
        <div class="ma-tiles">
          {genreTiles.map((t, i) => <FacetTile kind="genre" tile={t} rank={i} />)}
        </div>
        {moreGenres.length > 0 && (
          <details class="ma-more-facets">
            <summary>All genres <small>{moreGenres.length} more</small></summary>
            <ul class="ma-pills">
              {moreGenres.map((g) => <li><a class="ma-pill" href={g.href}>{g.label}<small>{g.count}</small></a></li>)}
            </ul>
          </details>
        )}
      </section>
      <section class="ma-browse" id="countries" aria-labelledby="countries-h">
        <h2 class="ma-sect__title" id="countries-h">Countries</h2>
        <div class="ma-tiles">
          {countryTiles.map((t, i) => <FacetTile kind="country" tile={t} rank={i} />)}
        </div>
        {moreCountries.length > 0 && (
          <details class="ma-more-facets">
            <summary>All countries <small>{moreCountries.length} more</small></summary>
            <ul class="ma-pills">
              {moreCountries.map((c) => <li><a class="ma-pill" href={c.href}>{c.flag && <span aria-hidden="true">{c.flag}</span>}{c.label}<small>{c.count}</small></a></li>)}
            </ul>
          </details>
        )}
      </section>
    </div>
  </main>

  <Footer />
</body>
</html>
