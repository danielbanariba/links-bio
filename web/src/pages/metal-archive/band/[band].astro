---
// Band discography page, "the dark room" (premium redesign, 2026): one page per band
// with 2+ albums.
//
// A header band in the colour of the band's latest cover (cover lit on the right, the name
// in the display face, a facts line, Play latest), then the discography as a cover grid.
// Live recordings are Daniel's own live sets, not part of the band's catalogue, so they sit
// in their own section below, as the whole 16:9 frames they are.
//
// There is no photo, bio or rating in the DB: everything on the page is derived from the
// band's albums (counts, years, genres, countries, views), never typed in.
//
// Route: /metal-archive/band/{slug}
// slugify is imported from db.ts, the single source of truth shared with the pages that
// link here, so generated paths and rendered links can never drift apart.
//
// Play latest drives the shared global Player the same way the album page does: this page
// exposes its latest album as the #metal-np-data island (the Player cues it on
// astro:page-load) and marks the button `.js-pp` + `data-np-main`.
import { ClientRouter } from 'astro:transitions';
import {
  getBandsWithMultipleAlbums,
  getAlbumsByBand,
  getBandViews,
  getAlbum,
  getTracks,
  isLiveRecording,
  slugify,
} from '../../../lib/db.js';
import { countryLabel, genreLabel } from '../../../lib/labels.js';
import { tsToSeconds } from '../../../lib/tracks.js';
import { getAlbumColor } from '../../../lib/vibrant.js';
import { safeJsonLd } from '../../../lib/seo.js';
import AlbumCard from '../../../components/AlbumCard.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import ArchiveHead from '../../../components/ArchiveHead.astro';
import PageHead from '../../../components/PageHead.astro';
import Reveal from '../../../components/Reveal.astro';
import '../../../styles/global.css';

export function getStaticPaths() {
  const bands = getBandsWithMultipleAlbums();
  return bands.map((b) => ({
    params: { band: slugify(b.band_name) },
    props: { realName: b.band_name, totalCount: b.count },
  }));
}

interface Props {
  realName: string;
  totalCount: number;
}

const { realName, totalCount } = Astro.props;
const allAlbums = getAlbumsByBand(realName);

// Split studio/official vs live recordings.
const studioAlbums = allAlbums.filter((a) => !isLiveRecording(a.album_title));
const liveAlbums   = allAlbums.filter((a) =>  isLiveRecording(a.album_title));

// ─── Search-engine data (meta and JSON-LD): from the whole catalogue, live sets included ──
const genres = [...new Set(allAlbums.map((a) => genreLabel(a.genre)).filter(Boolean))];
const ldImage = allAlbums[0]?.thumb || '';

// ─── Header: the band's latest studio release (a live set only if there is no other) ──
// The catalogue the header describes is the studio albums; a band with nothing but live
// sets is described by those.
const latest = studioAlbums[0] ?? allAlbums[0] ?? null;
const catalogue = studioAlbums.length ? studioAlbums : allAlbums;
const bandColor = latest ? await getAlbumColor(latest.thumb, latest.cover) : '';

const nf = new Intl.NumberFormat('en-US');
const compact = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });
const plural = (n: number, one: string, many: string) => `${nf.format(n)} ${n === 1 ? one : many}`;

// Facets are counted on the RAW values (the slugs of the genre and country pages come from
// them) and shown by their English label, deduped after translating: "Venezuela" and
// "Venezuela, Bolivarian Republic of" are one name on this page. Genre and country pages list
// studio albums only, so a live-only band links to neither.
const topRaw = (values: Array<string | null>, limit: number) => {
  const counts = new Map<string, number>();
  for (const v of values) if (v) counts.set(v, (counts.get(v) ?? 0) + 1);
  return [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, limit).map(([raw]) => raw);
};
const linkable = studioAlbums.length > 0;
const genreFacts = topRaw(catalogue.map((a) => a.genre), 3).map((raw) => ({
  text: genreLabel(raw),
  href: linkable ? `/metal-archive/genre/${slugify(raw)}` : undefined,
}));
const countryFacts: { text: string; href?: string }[] = [];
for (const raw of topRaw(catalogue.map((a) => a.country), 3)) {
  const text = countryLabel(raw);
  if (countryFacts.some((c) => c.text === text)) continue;
  countryFacts.push({ text, href: linkable ? `/metal-archive/country/${slugify(raw)}` : undefined });
}
// year 0 means "unknown"; a bare `0 && ...` would render a literal "0" (see lib/cardMeta.ts).
const years = catalogue.map((a) => a.year).filter((y): y is number => !!y);
const yearRange = years.length
  ? (Math.min(...years) === Math.max(...years) ? String(Math.min(...years)) : `${Math.min(...years)}–${Math.max(...years)}`)
  : '';
const views = getBandViews(realName);

const facts: { text: string; href?: string }[] = [
  studioAlbums.length > 0 ? { text: plural(studioAlbums.length, 'album', 'albums') } : null,
  liveAlbums.length > 0 ? { text: plural(liveAlbums.length, 'live set', 'live sets') } : null,
  yearRange ? { text: yearRange } : null,
  ...genreFacts,
  ...countryFacts,
  views > 0 ? { text: `${views < 1000 ? nf.format(views) : compact.format(views)} ${views === 1 ? 'view' : 'views'}` } : null,
].filter((f): f is { text: string; href?: string } => f !== null);

const leadPic = latest && latest.cover
  ? {
      href: `/metal-archive/album/${latest.id}`,
      cover: latest.cover,
      frame: isLiveRecording(latest.album_title),
      kind: isLiveRecording(latest.album_title) ? 'Latest live set' : 'Latest release',
      detail: [latest.album_title, latest.year || ''].filter(Boolean).join(' · '),
    }
  : null;

// ─── Player data island: the latest album, exactly the shape the Player reads ─────────
const latestFull = latest ? getAlbum(latest.id) : null;
const latestTracks = latest
  ? getTracks(latest.id).map((t, i) => ({ idx: i, name: t.track_name, seconds: tsToSeconds(t.timestamp) }))
  : [];
const hasVideo = !!(latest?.youtube_video_id && latest.youtube_video_id.trim() !== '');
const npData = latest && hasVideo
  ? {
      videoId: latest.youtube_video_id,
      youtubeUrl: latestFull?.youtube_url || '',
      albumColor: bandColor,
      albumTitle: latest.album_title,
      bandName: realName,
      coverThumb: latest.thumb || latest.cover,
      tracks: latestTracks,
    }
  : null;
// set:html does NOT HTML-escape: neutralise "<" so a stray "</script>" in a title cannot close the tag.
const npDataJson = npData ? JSON.stringify(npData).replace(/</g, '\\u003c') : '';

const pageTitle = `${realName} — Discography · Metal Archive`;
const metaDesc  = `${totalCount} ${totalCount === 1 ? 'release' : 'releases'} by ${realName} in the Metal Archive.${genres.length ? ' ' + genres.join(', ') + '.' : ''}`;
const canonical = `https://danielbanariba.com/metal-archive/band/${slugify(realName)}`;

// ─── Schema.org structured data (MusicGroup) ─────────────────────────────────
const bandJsonLd = safeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  '@id': `${canonical}#band`,
  name: realName,
  url: canonical,
  ...(genres.length ? { genre: genres } : {}),
  ...(ldImage ? { image: ldImage } : {}),
  album: allAlbums.map((a) => ({
    '@type': 'MusicAlbum',
    name: a.album_title,
    url: `https://danielbanariba.com/metal-archive/album/${a.id}`,
  })),
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={bandJsonLd} />
    <ArchiveHead />
    <ClientRouter />
  </head>
  <body class="ma">
    <Reveal />
    <Navbar />

    <main id="main" tabindex="-1">
      <!-- ─── Header: the name, what the archive holds of it, Play latest ───────── -->
      <PageHead title={realName} color={bandColor} lead={leadPic}>
        <ul class="page-head__facts rise" style="--i:1" aria-label="About this band">
          {facts.map((f) => <li>{f.href ? <a href={f.href}>{f.text}</a> : f.text}</li>)}
        </ul>
        <div class="page-head__actions rise" style="--i:2">
          {hasVideo && (
            <button type="button" class="btn btn--primary page-head__play js-pp" aria-label="Play or pause the latest release" data-np-main="1" data-state="paused">
              <svg class="ic ic-play" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
              <svg class="ic ic-pause" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM14 5h4v14h-4z"/></svg>
              <span class="ic ic-spinner" aria-hidden="true"></span>
              <span class="pp-lbl pp-lbl--play">Play latest</span>
              <span class="pp-lbl pp-lbl--pause">Pause</span>
              <span class="pp-lbl pp-lbl--wait">Loading</span>
            </button>
          )}
          <button type="button" class="btn btn--secondary" data-share="1" aria-label="Share this band">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.6" y1="13.5" x2="15.4" y2="17.5"/><line x1="15.4" y1="6.5" x2="8.6" y2="10.5"/></svg>
            <span>Share</span>
          </button>
        </div>
      </PageHead>

      <!-- ─── Studio / official works ─────────────────────────────────────────── -->
      {studioAlbums.length > 0 && (
        <section class="sect" aria-labelledby="disc-title" data-reveal>
          <h2 class="sect-title rv" id="disc-title" style="--i:0">Discography</h2>
          <ul class="wall rv" style="--i:1">
            {studioAlbums.map((album, i) => <li><AlbumCard album={album} ofBand loading={i < 5 ? 'eager' : 'lazy'} /></li>)}
          </ul>
        </section>
      )}

      <!-- ─── Live recordings: Daniel's own live sets, whole frames ──────────── -->
      {liveAlbums.length > 0 && (
        <section class="sect" aria-labelledby="live-title" data-reveal>
          <h2 class="sect-title rv" id="live-title" style="--i:0">Live recordings</h2>
          <p class="sect-lead rv" style="--i:1">Live sets and concert recordings.</p>
          <ul class="wall wall--frames rv" style="--i:2">
            {liveAlbums.map((album) => <li><AlbumCard album={album} ofBand frame /></li>)}
          </ul>
        </section>
      )}
    </main>

    <!-- Player data island (see the header comment). NOT persisted: it is replaced on every
         navigation so the Player sees this page's album. Only emitted with a playable video. -->
    {npData && <script type="application/json" id="metal-np-data" is:inline set:html={npDataJson} />}
    {npData && (
      <span hidden data-track-idx="0" data-seconds={String(latestTracks[0]?.seconds ?? 0)}>
        <span data-track-name>{latestTracks[0]?.name || latest?.album_title}</span>
      </span>
    )}

    <Footer cover={latest?.cover || undefined} />
  </body>
</html>
