---
// Slug strategy: genres contain spaces and slashes (e.g. "Brutal Death Metal/Goregrind").
// A raw "/" in a path param would create a nested route, so we slugify:
//   "Brutal Death Metal/Goregrind" -> "brutal-death-metal-goregrind"
//
// COLLISION FIX: distinct raw genre strings can slugify to the SAME value
// (e.g. "Black Death Metal" and "Black/Death Metal" both -> "black-death-metal",
// 1 album vs 31). getStaticPaths used to emit one path per RAW value, so the
// build silently overwrote the bigger page with the smaller one. It now groups
// by slug via getGenreFacetGroups() (db.ts), so exactly one page is built per
// slug and it lists every album from every raw variant that collides into it.
// `label` is the raw value with the highest count — used for the display name
// and the "Refine in Browse" link.
import { ClientRouter } from 'astro:transitions';
import { getGenreFacetGroups, getAlbumsByGenres, getFacetLead } from '../../../lib/db.js';
import { genreLabel } from '../../../lib/labels.js';
import { getAlbumColor } from '../../../lib/vibrant.js';
import FacetMain from '../../../components/FacetMain.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import ArchiveHead from '../../../components/ArchiveHead.astro';
import Reveal from '../../../components/Reveal.astro';
import '../../../styles/global.css';

export function getStaticPaths() {
  const groups = getGenreFacetGroups();
  return groups.map((group) => ({
    params: { genre: group.slug },
    props: { genreValues: group.values, primaryGenre: group.label },
  }));
}

interface Props {
  genreValues: string[];
  primaryGenre: string;
}

const { genreValues, primaryGenre } = Astro.props;
// NOT_LIVE applied inside getAlbumsByGenres; derive the count from the same
// list so the header number and the grid always agree (comparable to Browse).
const albums = getAlbumsByGenres(genreValues);
const count = albums.length;

// The page leads with the genre's most played record; its cover sets the header colour (the
// cached vibrant extractor, never a cold build). With no views anywhere in the genre the
// newest upload (albums is ordered upload_date DESC) stands in, so the header is never bare.
// Card.thumb is already the mqdefault URL the cache is keyed by.
const lead = getFacetLead('genre', genreValues);
const repCover = lead ?? albums[0] ?? null;
const genreColor = repCover ? await getAlbumColor(repCover.thumb, repCover.cover) : '';

// Chain to Browse with this genre pre-applied. The Search island restores its
// dropdown from the exact value (e.genre === genre), so the URL must carry the
// dominant REAL genre, not the slug.
const browseHref = `/metal-archive/browse?genre=${encodeURIComponent(primaryGenre)}`;

// Genres are already English except for one Spanish placeholder value; the slug
// and the ?genre= link still carry the RAW (dominant) value so nothing breaks.
const genreName = genreLabel(primaryGenre);

const pageTitle = `${genreName} — Metal Archive`;
const metaDesc = `${count} ${genreName} ${count === 1 ? 'album' : 'albums'} in the Metal Archive.`;
const canonical = `https://danielbanariba.com/metal-archive/genre/${Astro.params.genre}`;
const ogImage = albums[0]?.thumb || undefined;

const nf = new Intl.NumberFormat('en-US');
const sentence = `${nf.format(count)} ${count === 1 ? 'album' : 'albums'} in this genre, newest upload first.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDesc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="canonical" href={canonical} />
    <ArchiveHead />
    <ClientRouter />
  </head>
  <body class="ma">
    <Reveal />
    <Navbar />

    <FacetMain
      title={genreName}
      sentence={sentence}
      browseHref={browseHref}
      albums={albums}
      lead={lead}
      leadKind="Most played in this genre"
      color={genreColor}
      empty="No albums in this genre yet."
    />

    <Footer cover={(lead ?? albums[0])?.cover || undefined} />
  </body>
</html>
