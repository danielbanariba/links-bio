---
// Slug strategy: genres contain spaces and slashes (e.g. "Brutal Death Metal/Goregrind").
// A raw "/" in a path param would create a nested route, so we slugify:
//   "Brutal Death Metal/Goregrind" -> "brutal-death-metal-goregrind"
//
// COLLISION FIX: distinct raw genre strings can slugify to the SAME value
// (e.g. "Black Death Metal" and "Black/Death Metal" both -> "black-death-metal",
// 1 album vs 31). getStaticPaths used to emit one path per RAW value, so the
// build silently overwrote the bigger page with the smaller one. It now groups
// by slug via getGenreFacetGroups() (db.ts), so exactly one page is built per
// slug and it lists every album from every raw variant that collides into it.
// `label` is the raw value with the highest count — used for the display name
// and the "Refine in Browse" link.
import { ClientRouter } from 'astro:transitions';
import { getGenreFacetGroups, getAlbumsByGenres } from '../../../lib/db.js';
import { genreLabel } from '../../../lib/labels.js';
import { getAlbumAccent } from '../../../lib/vibrant.js';
import { accentHtmlAttrs } from '../../../lib/accent.js';
import AlbumGrid from '../../../components/AlbumGrid.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/global.css';

export function getStaticPaths() {
  const groups = getGenreFacetGroups();
  return groups.map((group) => ({
    params: { genre: group.slug },
    props: { genreValues: group.values, primaryGenre: group.label },
  }));
}

interface Props {
  genreValues: string[];
  primaryGenre: string;
}

const { genreValues, primaryGenre } = Astro.props;
// NOT_LIVE applied inside getAlbumsByGenres; derive the count from the same
// list so the header number and the grid always agree (comparable to Browse).
const albums = getAlbumsByGenres(genreValues);
const count = albums.length;

// P2 mini-hero color: the page's accent comes from the representative (newest)
// album's cover (its square crop when there is one) via the cached vibrant
// extractor. albums is already ordered upload_date DESC (discovery order). Null
// when it has none: the stylesheet's amber applies.
const repCover = albums[0]?.thumb ?? '';
const genreAccent = albums[0] ? await getAlbumAccent({ videoId: albums[0].youtube_video_id, thumbUrl: repCover }) : null;

// Chain to Browse with this genre pre-applied. The Search island restores its
// dropdown from the exact value (e.genre === genre), so the URL must carry the
// dominant REAL genre, not the slug.
const browseHref = `/metal-archive/browse?genre=${encodeURIComponent(primaryGenre)}`;

// Genres are already English except for one Spanish placeholder value; the slug
// and the ?genre= link still carry the RAW (dominant) value so nothing breaks.
const genreName = genreLabel(primaryGenre);

const pageTitle = `${genreName} — Metal Archive`;
const metaDesc = `${count} ${genreName} ${count === 1 ? 'album' : 'albums'} in the Metal Archive.`;
const canonical = `https://danielbanariba.com/metal-archive/genre/${Astro.params.genre}`;
const ogImage = repCover || undefined;
---

<!doctype html>
<html lang="en" {...accentHtmlAttrs(genreAccent)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDesc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="canonical" href={canonical} />
    <ClientRouter />
  </head>
  <body>
    <Navbar />

    <main class="wrap" id="main" tabindex="-1" style="padding-top: 2rem;">
      <header class="facet-hero">
        <h1 class="facet-hero__title">{genreName}</h1>
        <p class="facet-hero__count">
          {count} {count === 1 ? 'album' : 'albums'}
        </p>
        {albums.length > 0 && (
          <a class="facet-refine" href={browseHref}>Refine in Browse →</a>
        )}
      </header>

      {albums.length > 0
        ? <AlbumGrid albums={albums} />
        : <p style="color: var(--text-footer);">No albums in this genre yet.</p>
      }
    </main>

    <Footer />
  </body>
</html>
