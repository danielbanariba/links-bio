---
// submit.astro — Submit a band to the Metal Archive
// POSTs to /api/metal-archive/submit (FastAPI on port 8001, proxied by host)
//
// The dark room (premium redesign, 2026): the shared head, then two columns on a desktop, the
// argument and the archive's real numbers on the left and the form on the right; on a phone the
// argument comes first. Fields sit on the ground with a 1px edge, labels are always visible.
import { ClientRouter } from 'astro:transitions';
import { getLatestUploads } from '../../lib/db.js';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ArchiveHead from '../../components/ArchiveHead.astro';
import PageHead from '../../components/PageHead.astro';
import Reveal from '../../components/Reveal.astro';
import Carousel from '../../components/Carousel.astro';
import FormFacts from '../../components/FormFacts.astro';
import '../../styles/global.css';

const GENRES = [
  "Death Metal", "Black Metal", "Thrash Metal", "Doom Metal",
  "Grindcore", "Power Metal", "Heavy Metal", "Melodic Death Metal",
  "Grind/Death Metal", "Punk Rock", "Metalcore", "Progressive Metal",
  "Folk Metal", "Symphonic Metal", "Sludge Metal", "Stoner Metal",
  "Speed Metal", "Brutal Death Metal",
];

const latest = getLatestUploads(8);

// The field of the head: a warm neutral, mixed down into the ground by PageHead (as Browse).
const HEAD_COLOR = '#8c8478';

const pageTitle = 'Submit your band | Metal Archive';
const metaDesc = 'Submit your band or album for review and free inclusion in the archive.';
const canonical = 'https://danielbanariba.com/metal-archive/submit';
const ogImage = 'https://danielbanariba.com/avatar.jpg';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDesc} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDesc} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDesc} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="canonical" href={canonical} />
  <ArchiveHead />
  <ClientRouter />
</head>
<body class="ma">
  <Reveal />
  <Navbar />

  <main id="main" tabindex="-1">
    <PageHead title="Submit your band" color={HEAD_COLOR} split>
      <p class="page-head__lead rise" style="--i:1">Submit your band or album for review and free inclusion in the archive.</p>
      <a class="btn btn--secondary fm-jump rise" style="--i:2" href="#form-title">Go to the form</a>
    </PageHead>

    <div class="fm">
      <!-- The argument: what happens next, and what the archive already holds -->
      <section class="fm-aside" data-reveal aria-labelledby="next-title">
        <h2 class="fm-title rv" id="next-title" style="--i:0">What happens next</h2>
        <ol class="fm-steps rv" style="--i:1">
          <li>
            <strong class="fm-steps__name">We review your submission</strong>
            <span class="fm-steps__text">We listen to your music and verify the details.</span>
          </li>
          <li>
            <strong class="fm-steps__name">We get in touch</strong>
            <span class="fm-steps__text">If your band is selected, we'll contact you to arrange the next steps.</span>
          </li>
          <li>
            <strong class="fm-steps__name">We publish your album</strong>
            <span class="fm-steps__text">Your album goes live in the archive with all its details.</span>
          </li>
        </ol>
        <div class="rv" style="--i:2">
          <FormFacts lead="Your album would join" />
        </div>
      </section>

      <!-- The form -->
      <div class="fm-main">
        <!-- Success state (hidden by default, shown via JS) -->
        <div class="fm-done" id="success-state" style="display:none" tabindex="-1" role="status">
          <h2 class="fm-done__title">Band submitted</h2>
          <p class="fm-done__body">
            We'll review your submission and get back to you soon. Keep an eye on your inbox.
          </p>
          <a href="/metal-archive" class="btn btn--secondary">Back to the archive</a>
        </div>

        <form id="submit-form" class="fm-form" novalidate aria-labelledby="form-title">
          <h2 class="fm-title rise" id="form-title" style="--i:2">About your band</h2>
          <p class="fm-hint rise" style="--i:3">Fields marked * are required.</p>

          <!-- Band name + email -->
          <div class="fm-row rise" style="--i:4">
            <div class="fm-field">
              <label class="fm-label" for="band_name">Band name <span class="fm-req" aria-hidden="true">*</span></label>
              <input
                id="band_name" name="band_name" type="text"
                class="fm-input" placeholder="e.g. Blasfemia…" required
              />
            </div>
            <div class="fm-field">
              <label class="fm-label" for="contact_email">Contact email <span class="fm-req" aria-hidden="true">*</span></label>
              <input
                id="contact_email" name="contact_email" type="email"
                class="fm-input" placeholder="band@email.com" autocomplete="email" spellcheck="false" required
              />
            </div>
          </div>

          <!-- Genre + Country -->
          <div class="fm-row rise" style="--i:5">
            <div class="fm-field">
              <label class="fm-label" for="genre">Genre <span class="fm-req" aria-hidden="true">*</span></label>
              <div class="fm-pick">
                <select id="genre" name="genre" class="fm-input" required>
                  <option value="">Pick a genre</option>
                  {GENRES.map(g => <option value={g}>{g}</option>)}
                </select>
                <svg class="fm-chev" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </div>
            </div>
            <div class="fm-field">
              <label class="fm-label" for="country">Country <span class="fm-req" aria-hidden="true">*</span></label>
              <input
                id="country" name="country" type="text"
                class="fm-input" placeholder="e.g. Honduras…" required
              />
            </div>
          </div>

          <!-- Album title + Year -->
          <div class="fm-row rise" style="--i:6">
            <div class="fm-field">
              <label class="fm-label" for="album_title">Album title</label>
              <input
                id="album_title" name="album_title" type="text"
                class="fm-input" placeholder="e.g. Inmaculada Concepcion…"
              />
            </div>
            <div class="fm-field">
              <label class="fm-label" for="year">Release year</label>
              <input
                id="year" name="year" type="number" inputmode="numeric"
                class="fm-input" placeholder="e.g. 2024…" min="1960" max="2030"
              />
            </div>
          </div>

          <!-- YouTube + Bandcamp -->
          <div class="fm-row rise" style="--i:7">
            <div class="fm-field">
              <label class="fm-label" for="youtube_url">YouTube URL</label>
              <input
                id="youtube_url" name="youtube_url" type="url"
                class="fm-input" placeholder="https://youtu.be/…" spellcheck="false"
              />
            </div>
            <div class="fm-field">
              <label class="fm-label" for="bandcamp_url">Bandcamp URL</label>
              <input
                id="bandcamp_url" name="bandcamp_url" type="url"
                class="fm-input" placeholder="https://band.bandcamp.com" spellcheck="false"
              />
            </div>
          </div>

          <!-- Description -->
          <div class="fm-field rise" style="--i:8">
            <label class="fm-label" for="description">Description</label>
            <textarea
              id="description" name="description"
              class="fm-input fm-textarea" placeholder="Tell us about your band…"
              rows="5"
            ></textarea>
          </div>

          <!-- Honeypot: invisible and unreachable for a real visitor. A bot
               that fills every field fills this one too, so the server can
               drop the submission silently. Never display:none -- some bots
               skip fields hidden that way. -->
          <input
            type="text" id="website" name="website" class="sr-only"
            tabindex="-1" autocomplete="off" aria-hidden="true"
          />

          <!-- Failure note -->
          <div class="fm-note" id="form-toast" role="alert" hidden></div>

          <div class="fm-actions rise" style="--i:9">
            <button type="submit" class="btn btn--primary fm-submit" id="submit-btn">
              Submit band
            </button>
          </div>
        </form>
      </div>
    </div>

    <Carousel id="new" title="Recently added" albums={latest} href="/metal-archive/browse" hrefLabel="See all" />
  </main>

  <Footer />
</body>
</html>

<script>
  // Wrapped in astro:page-load so the form handler re-binds after client-side
  // navigation (with ClientRouter this <script> does not re-execute on swap).
  // A per-form flag prevents double-binding.
  import { API_BASE, FORM_FETCH_TIMEOUT_MS, FORM_TIMEOUT_MESSAGE, isTimeoutError, timeoutSignal } from '../../lib/api.js';
  import { createFeedback, notSent, readFailure } from '../../components/form-feedback.js';

  function initSubmitForm() {
    const form     = document.getElementById('submit-form') as HTMLFormElement | null;
    const btn      = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const toast    = document.getElementById('form-toast') as HTMLElement | null;
    const success  = document.getElementById('success-state') as HTMLElement | null;
    if (!form || !btn || !toast || !success || (form as any).__bound) return;
    (form as any).__bound = true;

    // Failure note, inline field messages and the busy flag live in form-feedback.ts.
    const ui = createFeedback(form, toast);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      ui.clear();

      const data = Object.fromEntries(new FormData(form!));

      // Client-side required check — mark the FIRST empty required field.
      const required = ['band_name', 'contact_email', 'genre', 'country'];
      for (const field of required) {
        if (!String(data[field] ?? '').trim()) {
          ui.fieldError(field, 'This field is required.');
          return;
        }
      }

      btn!.disabled = true;
      btn!.textContent = 'Submitting...';
      ui.busy(true);

      try {
        const res = await fetch(`${API_BASE}/api/metal-archive/submit`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
          signal: timeoutSignal(FORM_FETCH_TIMEOUT_MS),
        });

        const json = await res.json().catch(() => ({}));

        if (res.ok) {
          form!.style.display = 'none';
          success!.style.display = 'flex';
          success!.focus();
        } else {
          ui.fail(readFailure(res.status, json));
        }
      } catch (err) {
        if (isTimeoutError(err)) {
          ui.fail(notSent(FORM_TIMEOUT_MESSAGE));
        } else {
          ui.fail(notSent('Could not connect. Check your internet connection.'));
        }
      } finally {
        btn!.disabled = false;
        btn!.textContent = 'Submit band';
        ui.busy(false);
      }
    });
  }
  document.addEventListener('astro:page-load', initSubmitForm);
</script>
