---
// submit.astro — Submit a band to the Metal Archive
// POSTs to /api/metal-archive/submit (FastAPI on port 8001, proxied by host)
import { ClientRouter } from 'astro:transitions';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const GENRES = [
  "Death Metal", "Black Metal", "Thrash Metal", "Doom Metal",
  "Grindcore", "Power Metal", "Heavy Metal", "Melodic Death Metal",
  "Grind/Death Metal", "Punk Rock", "Metalcore", "Progressive Metal",
  "Folk Metal", "Symphonic Metal", "Sludge Metal", "Stoner Metal",
  "Speed Metal", "Brutal Death Metal",
];

const pageTitle = 'Submit your band | Metal Archive';
const metaDesc = 'Submit your band or album for review and free inclusion in the archive.';
const canonical = 'https://danielbanariba.com/metal-archive/submit';
const ogImage = 'https://danielbanariba.com/avatar.jpg';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDesc} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDesc} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDesc} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="canonical" href={canonical} />
  <ClientRouter />
</head>
<body class="form-page">
  <Navbar />

  <main class="form-page__main" id="main" tabindex="-1">
    <!-- Header -->
    <div class="form-page__header">
      <svg class="form-page__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m9 9 10.5-3m0 6.553v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 1 1-.99-3.467l2.31-.66a2.25 2.25 0 0 0 1.632-2.163Zm0 0V2.25L9 5.25v10.303m0 0v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 0 1-.99-3.467l2.31-.66A2.25 2.25 0 0 0 9 15.553Z" />
      </svg>
      <h1 class="form-page__title">Submit your band</h1>
      <p class="form-page__subtitle">
        Submit your band or album for review and free inclusion in the archive.
      </p>
    </div>

    <!-- Form card -->
    <div class="form-card" id="form-card">
      <!-- Success state (hidden by default, shown via JS) -->
      <div class="form-success" id="success-state" style="display:none">
        <span class="form-success__icon">&#10004;</span>
        <h2 class="form-success__title">Band submitted</h2>
        <p class="form-success__body">
          We'll review your submission and get back to you soon. Keep an eye on your inbox.
        </p>
        <a href="/metal-archive" class="form-success__back">&#8592; Back to the archive</a>
      </div>

      <!-- The form -->
      <form id="submit-form" class="form-stack" novalidate>
        <!-- Band name + email -->
        <div class="form-row">
          <div class="form-field">
            <label class="form-label" for="band_name">
              Band name <span class="form-label__required">*</span>
            </label>
            <input
              id="band_name" name="band_name" type="text"
              class="form-input" placeholder="e.g. Blasfemia" required
            />
          </div>
          <div class="form-field">
            <label class="form-label" for="contact_email">
              Contact email <span class="form-label__required">*</span>
            </label>
            <input
              id="contact_email" name="contact_email" type="email"
              class="form-input" placeholder="band@email.com" required
            />
          </div>
        </div>

        <!-- Genre + Country -->
        <div class="form-row">
          <div class="form-field">
            <label class="form-label" for="genre">
              Genre <span class="form-label__required">*</span>
            </label>
            <select id="genre" name="genre" class="form-select" required>
              <option value="">Pick a genre</option>
              {GENRES.map(g => <option value={g}>{g}</option>)}
            </select>
          </div>
          <div class="form-field">
            <label class="form-label" for="country">
              Country <span class="form-label__required">*</span>
            </label>
            <input
              id="country" name="country" type="text"
              class="form-input" placeholder="e.g. Honduras" required
            />
          </div>
        </div>

        <!-- Album title + Year -->
        <div class="form-row">
          <div class="form-field">
            <label class="form-label" for="album_title">Album title</label>
            <input
              id="album_title" name="album_title" type="text"
              class="form-input" placeholder="e.g. Inmaculada Concepcion"
            />
          </div>
          <div class="form-field">
            <label class="form-label" for="year">Release year</label>
            <input
              id="year" name="year" type="number"
              class="form-input" placeholder="e.g. 2024" min="1960" max="2030"
            />
          </div>
        </div>

        <!-- YouTube + Bandcamp -->
        <div class="form-row">
          <div class="form-field">
            <label class="form-label" for="youtube_url">YouTube URL</label>
            <input
              id="youtube_url" name="youtube_url" type="url"
              class="form-input" placeholder="https://youtu.be/..."
            />
          </div>
          <div class="form-field">
            <label class="form-label" for="bandcamp_url">Bandcamp URL</label>
            <input
              id="bandcamp_url" name="bandcamp_url" type="url"
              class="form-input" placeholder="https://band.bandcamp.com"
            />
          </div>
        </div>

        <!-- Description -->
        <div class="form-field">
          <label class="form-label" for="description">Description</label>
          <textarea
            id="description" name="description"
            class="form-textarea" placeholder="Tell us about your band..."
            rows="4"
          ></textarea>
        </div>

        <!-- Honeypot: invisible and unreachable for a real visitor. A bot
             that fills every field fills this one too, so the server can
             drop the submission silently. Never display:none -- some bots
             skip fields hidden that way. -->
        <input
          type="text" id="website" name="website" class="sr-only"
          tabindex="-1" autocomplete="off" aria-hidden="true"
        />

        <!-- Toast -->
        <div class="form-toast" id="form-toast" role="alert"></div>

        <button type="submit" class="form-submit" id="submit-btn">
          Submit band
        </button>
      </form>
    </div>

    <!-- What happens next -->
    <section class="form-steps">
      <h2 class="form-steps__title">What happens next?</h2>
      <div class="step-item">
        <span class="step-item__num">1</span>
        <div>
          <p class="step-item__title">We review your submission</p>
          <p class="step-item__desc">We listen to your music and verify the details.</p>
        </div>
      </div>
      <div class="step-item">
        <span class="step-item__num">2</span>
        <div>
          <p class="step-item__title">We get in touch</p>
          <p class="step-item__desc">If your band is selected, we'll contact you to arrange the next steps.</p>
        </div>
      </div>
      <div class="step-item">
        <span class="step-item__num">3</span>
        <div>
          <p class="step-item__title">We publish your album</p>
          <p class="step-item__desc">Your album goes live in the archive with all its details.</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</body>
</html>

<script>
  // Wrapped in astro:page-load so the form handler re-binds after client-side
  // navigation (with ClientRouter this <script> does not re-execute on swap).
  // A per-form flag prevents double-binding.
  import { API_BASE, FORM_FETCH_TIMEOUT_MS, FORM_TIMEOUT_MESSAGE, isTimeoutError, timeoutSignal } from '../../lib/api.js';

  function initSubmitForm() {
    const form     = document.getElementById('submit-form') as HTMLFormElement | null;
    const btn      = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const toast    = document.getElementById('form-toast') as HTMLElement | null;
    const success  = document.getElementById('success-state') as HTMLElement | null;
    if (!form || !btn || !toast || !success || (form as any).__bound) return;
    (form as any).__bound = true;

    function showToast(msg: string, isError: boolean) {
      toast!.textContent = msg;
      toast!.className = `form-toast ${isError ? 'form-toast--error' : 'form-toast--success'}`;
      toast!.style.display = 'block';
    }

    // Per-field validation: mark the offending input and show a message next to
    // it. Errors are cleared on every submit attempt. No extra hydration — this
    // runs inside the form's existing submit handler.
    function clearFieldErrors() {
      form!.querySelectorAll('.form-input--error').forEach((el) => {
        el.classList.remove('form-input--error');
        el.removeAttribute('aria-invalid');
        el.removeAttribute('aria-describedby');
      });
      form!.querySelectorAll('.form-field__error').forEach((el) => el.remove());
    }

    function markFieldError(name: string, message: string) {
      const input = form!.querySelector(`[name="${name}"]`) as HTMLElement | null;
      if (!input) return;
      input.classList.add('form-input--error');
      const msgId = `${name}-error`;
      const msg = document.createElement('span');
      msg.className = 'form-field__error';
      msg.id = msgId;
      msg.textContent = message;
      input.insertAdjacentElement('afterend', msg);
      // #13: the visual red border + adjacent message were invisible to
      // screen readers -- nothing tied the input to its error text or
      // flagged it as invalid.
      input.setAttribute('aria-invalid', 'true');
      input.setAttribute('aria-describedby', msgId);
      input.scrollIntoView({ block: 'center', behavior: 'smooth' });
      (input as HTMLInputElement).focus({ preventScroll: true });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      toast!.style.display = 'none';
      clearFieldErrors();

      const data = Object.fromEntries(new FormData(form!));

      // Client-side required check — mark the FIRST empty required field.
      const required = ['band_name', 'contact_email', 'genre', 'country'];
      for (const field of required) {
        if (!String(data[field] ?? '').trim()) {
          markFieldError(field, 'This field is required.');
          return;
        }
      }

      btn!.disabled = true;
      btn!.textContent = 'Submitting...';

      try {
        const res = await fetch(`${API_BASE}/api/metal-archive/submit`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
          signal: timeoutSignal(FORM_FETCH_TIMEOUT_MS),
        });

        const json = await res.json().catch(() => ({}));

        if (res.ok) {
          form!.style.display = 'none';
          success!.style.display = 'flex';
        } else {
          showToast(json.detail ?? 'Something went wrong. Please try again.', true);
        }
      } catch (err) {
        if (isTimeoutError(err)) {
          showToast(FORM_TIMEOUT_MESSAGE, true);
        } else {
          showToast('Could not connect. Check your internet connection.', true);
        }
      } finally {
        btn!.disabled = false;
        btn!.textContent = 'Submit band';
      }
    });
  }
  document.addEventListener('astro:page-load', initSubmitForm);
</script>
