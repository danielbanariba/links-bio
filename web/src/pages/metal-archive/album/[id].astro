---
// Album page, as in the prototype: the cover beside the title, the band in the
// accent and one line of facts; Play album, Share and YouTube; then the
// Tracklist and the Details side by side (stacked below 1100px), and rows of
// more albums: the band's others, similar albums, a random handful.
//
// Build-time work in the frontmatter:
//   - getAlbum / getTracks / getSimilarBands / getSimilarAlbums / getMoreToExplore
//     / getAlbumsByBand
//   - parse each track timestamp ("MM:SS" / "HH:MM:SS") to seconds
//   - getAlbumAccent() extracts the dominant swatch from the square crop (else
//     the thumb; cached), turns it into readable accent tokens (lib/accent.ts)
//     and bakes them on <html> -> zero runtime Vibrant.
//
// Playback lives in the persistent <Player> (Footer.astro, transition:persist).
// "Play album" is a ▶ like a card's (lib/cardPlay.ts), so it shows Pause only
// while THIS album plays; a tracklist row ([data-track-idx]) starts or seeks the
// album through the Player's click handler, which reads the album's tracks from
// the JSON data island (#metal-np-data) below.
import {
  getAllAlbumIds,
  getAlbum,
  getTracks,
  getSimilarBands,
  getSimilarAlbums,
  getMoreToExplore,
  getAlbumsByBand,
  getBandAlbumCount,
  hasFacetPage,
  isLiveRecording,
  slugify,
} from '../../../lib/db.js';
import { countryFlag, countryLabel, genreLabel } from '../../../lib/labels.js';
import { thumb } from '../../../lib/thumb.js';
import { coverUrl as squareCover } from '../../../lib/coverStore.js';
import { coverMode } from '../../../lib/coverDisplay.js';
import { displayTitle } from '../../../lib/title.js';
import { tsToSeconds, trackLengths } from '../../../lib/segments.js';
import { formatCardMeta, formatUploadDay, NO_GENRE } from '../../../lib/cardMeta.js';
import { playAttrs, bandHref } from '../../../lib/cardPlay.js';
import { getAlbumAccent } from '../../../lib/vibrant.js';
import { accentHtmlAttrs, encodeAccent } from '../../../lib/accent.js';
import { GLYPH_PLAY } from '../../../lib/icons.js';
import { safeJsonLd } from '../../../lib/seo.js';
import { ClientRouter } from 'astro:transitions';
import AlbumCard from '../../../components/AlbumCard.astro';
import ArchiveChrome from '../../../components/ArchiveChrome.astro';
import CoverArt from '../../../components/CoverArt.astro';
import Footer from '../../../components/Footer.astro';
import Icon from '../../../components/Icon.astro';
import Row from '../../../components/Row.astro';
import '../../../styles/global.css';
import '../../../styles/archive.css';

export function getStaticPaths() {
  // NOTE: db helpers are imported at module scope, but Astro compiles
  // getStaticPaths into a separate prerender chunk. Re-import inside to be safe
  // is not needed for imported bindings (they resolve fine); only frontmatter
  // *local functions* are unavailable here. getAllAlbumIds is a module import.
  const ids = getAllAlbumIds();
  return ids.map((id) => ({ params: { id: String(id) } }));
}

const id = Number(Astro.params.id);
const album = getAlbum(id);

// Astro static build: a missing album would be a build-time data bug, not a
// runtime 404. getStaticPaths only emits real IDs, so album is always present.
if (!album) {
  throw new Error(`Album ${id} not found at build time`);
}

const rawTracks = getTracks(id);
const similarBands = getSimilarBands(id);
const similarAlbums = getSimilarAlbums(album.genre, id);
const moreToExplore = getMoreToExplore(id);
// The band's other albums, newest first; its live sets keep their microphone tile.
const moreFromBand = getAlbumsByBand(album.band_name).filter((a) => a.id !== album.id);

// Timestamps ("MM:SS" / "HH:MM:SS") to seconds: lib/segments.ts, shared with the
// per-album JSON the Player fetches (album/[id].json.ts). A length is shown only
// up to the next start; without trustworthy starts there are none, and no
// "Starts at" line either.
const starts = rawTracks.map((t) => tsToSeconds(t.timestamp));
const lengths = trackLengths(starts);
const timed = lengths.some((l) => l !== null);
const tracks = rawTracks.map((t, i) => ({
  idx: i,
  number: t.track_number ?? i + 1,
  name: t.track_name,
  seconds: starts[i],
  length: lengths[i],
}));
// "0:08", "11:10", "1:02:03": a clock, without the database's leading zero.
const two = (n: number) => String(n).padStart(2, '0');
const clock = (s: number) =>
  s >= 3600 ? `${Math.floor(s / 3600)}:${two(Math.floor(s / 60) % 60)}:${two(s % 60)}` : `${Math.floor(s / 60)}:${two(s % 60)}`;
const plural = (n: number, word: string) => `${n.toLocaleString('en-US')} ${word}${n === 1 ? '' : 's'}`;

// ─── Artwork: the square crop or the whole frame (CoverArt); thumb for og ────
const coverUrl = album.album_artwork_url || '';
const coverThumb = thumb(album.album_artwork_url);
const title = displayTitle(album.album_title);

// ─── Build-time color: the album's accent tokens, baked on <html> ────────────
// From the square crop when the covers step made one; else the small thumb
// (mqdefault), then the full cover if the thumb 404s or can't be decoded. Null
// when nothing could be extracted: the stylesheet's amber applies.
const videoId = (album.youtube_video_id || '').trim();
const accent = await getAlbumAccent({ videoId, thumbUrl: coverThumb || coverUrl, fullUrl: coverUrl });

// ─── Streaming / social links ────────────────────────────────────────────────
// Many descriptions are scraped text that embeds the band's links (Bandcamp,
// Spotify, Metal Archives, socials…). We pull every URL out of the description
// AND the dedicated DB columns, classify each by platform, and render them as
// proper buttons instead of dumping the raw text. Deduped by platform.
const LINK_PLATFORMS: { test: RegExp; label: string }[] = [
  { test: /bandcamp\.com/i, label: 'Bandcamp' },
  { test: /spotify\.com/i, label: 'Spotify' },
  { test: /music\.apple\.com|itunes\.apple\.com/i, label: 'Apple Music' },
  { test: /metal-archives\.com/i, label: 'Metal Archives' },
  { test: /facebook\.com|fb\.com/i, label: 'Facebook' },
  { test: /instagram\.com/i, label: 'Instagram' },
  { test: /soundcloud\.com/i, label: 'SoundCloud' },
  { test: /deezer\.com/i, label: 'Deezer' },
  { test: /tidal\.com/i, label: 'Tidal' },
  { test: /(twitter\.com|x\.com)/i, label: 'Twitter / X' },
  { test: /tiktok\.com/i, label: 'TikTok' },
  { test: /youtube\.com|youtu\.be/i, label: 'YouTube' },
];
function classifyLink(url: string): string {
  for (const p of LINK_PLATFORMS) if (p.test.test(url)) return p.label;
  try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return 'Link'; }
}
const dbLinkUrls = [
  album.spotify_url, album.bandcamp_url, album.apple_music_url,
  album.metal_archives_url, album.facebook_url, album.instagram_url,
].filter((u): u is string => !!u && u.trim() !== '');
const descUrls = (album.description || '').match(/https?:\/\/[^\s)<>"']+/g) || [];
const allLinkUrls = [...new Set([...dbLinkUrls, ...descUrls].map((u) => u.replace(/[.,;]+$/, '').trim()))];
const seenPlatform = new Set<string>();
// Drop links back to our own site(s) — those aren't external platforms.
const SELF_DOMAINS = /(danielbanariba\.com|xeroxunderground\.com)/i;
const platformLinks = allLinkUrls
  .map((url) => ({ label: classifyLink(url), url }))
  .filter((l) => l.label !== 'YouTube')        // YouTube already has its own button in the hero
  .filter((l) => !SELF_DOMAINS.test(l.url))     // remove our own website (danielbanariba.com)
  .filter((l) => { if (seenPlatform.has(l.label)) return false; seenPlatform.add(l.label); return true; });

// Brand logos for each link button (monochrome, currentColor). Best-effort
// single-path marks; platforms without a real logo fall back to a globe.
function platformIcon(label: string): string {
  const wrap = (inner: string, opts = '') =>
    `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" ${opts}>${inner}</svg>`;
  switch (label) {
    case 'Spotify':
      return wrap('<path fill="currentColor" d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.52 17.34c-.24.36-.66.48-1.02.24-2.82-1.74-6.36-2.1-10.56-1.14-.42.12-.78-.18-.9-.54-.12-.42.18-.78.54-.9 4.56-1.02 8.52-.6 11.64 1.32.42.18.48.66.3 1.02zm1.44-3.3c-.3.42-.84.6-1.26.3-3.24-1.98-8.16-2.58-11.94-1.38-.48.12-1.02-.12-1.14-.6-.12-.48.12-1.02.6-1.14C9.6 9.9 15 10.56 18.72 12.84c.36.18.54.78.24 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.3c-.6.18-1.2-.18-1.38-.72-.18-.6.18-1.2.72-1.38 4.26-1.26 11.28-1.02 15.72 1.62.54.3.72 1.02.42 1.56-.3.42-1.02.6-1.56.3z"/>');
    case 'Bandcamp':
      return wrap('<path fill="currentColor" d="M0 18.75l7.44-13.5H24l-7.44 13.5H0z"/>');
    case 'Apple Music':
      return wrap('<path fill="currentColor" d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>');
    case 'Facebook':
      return wrap('<path fill="currentColor" d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07c0 6 4.39 10.97 10.13 11.85v-8.38H7.08v-3.47h3.04V9.43c0-3 1.79-4.66 4.53-4.66 1.31 0 2.68.23 2.68.23v2.95H15.8c-1.49 0-1.95.92-1.95 1.87v2.25h3.32l-.53 3.47h-2.79v8.38C19.6 23.04 24 18.07 24 12.07z"/>');
    case 'Instagram':
      return wrap('<path fill="currentColor" d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85C2.38 3.93 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16zm0-2.16C8.74 0 8.33.01 7.05.07 2.7.27.28 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.41-10.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"/>');
    case 'Twitter / X':
      return wrap('<path fill="currentColor" d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.66l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.01 4.13H5.04l12.04 15.64z"/>');
    case 'SoundCloud':
      return wrap('<path fill="currentColor" d="M1.2 12.6c-.07 0-.12.05-.13.12L.9 14.46l.17 1.71c.01.07.06.12.13.12.06 0 .12-.05.12-.12l.2-1.71-.2-1.74c0-.07-.06-.12-.12-.12zm12.9 1.86l.28-.06c.4-.02.74.32.74.74 0 .42-.34.76-.76.76h-4.6V9.6c.5-.3 1.08-.46 1.7-.46 1.78 0 3.22 1.4 3.3 3.16.18-.08.38-.12.59-.12.5 0 .9.4.9.9 0 .12-.02.23-.06.34M9.7 9.54l-.25 4.16.25 1.65c.01.13.12.24.25.24.13 0 .24-.1.25-.24l.28-1.65-.28-4.16c-.01-.13-.12-.24-.25-.24-.13 0-.24.1-.25.24zm-2.08.62l-.22 3.54.22 1.66c.01.13.12.23.26.23.13 0 .24-.1.25-.23l.25-1.66-.25-3.54c-.01-.13-.12-.23-.25-.23-.14 0-.25.1-.26.23z"/>');
    case 'Deezer':
      return wrap('<g fill="currentColor"><rect x="16.5" y="6.6" width="7.5" height="2.3"/><rect x="16.5" y="10" width="7.5" height="2.3"/><rect x="8.25" y="13.4" width="7.5" height="2.3"/><rect x="16.5" y="13.4" width="7.5" height="2.3"/><rect x="0" y="16.8" width="7.5" height="2.3"/><rect x="8.25" y="16.8" width="7.5" height="2.3"/><rect x="16.5" y="16.8" width="7.5" height="2.3"/></g>');
    default:
      return wrap('<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/>', 'fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"');
  }
}

const releaseType = album.release_type && album.release_type.trim() !== '' ? album.release_type : 'Album';

// ─── Discovery links (genre / year / band / country) ─────────────────────────
// A fact links to its page only when the build makes one (hasFacetPage: a value
// only a live set has gets none). The band link is its page when it has one,
// else a Browse search (bandHref), so it always lands somewhere.
const bandAlbumCount = getBandAlbumCount(album.band_name);
const bandSlug = bandAlbumCount >= 2 ? slugify(album.band_name) : null;
const genreRaw = album.genre && album.genre.trim() !== '' && album.genre !== NO_GENRE ? album.genre : null;
const genreSlug = genreRaw ? slugify(genreRaw) : null;
const genreHref = genreSlug && hasFacetPage('genre', genreSlug) ? `/metal-archive/genre/${genreSlug}` : null;
const yearHref = album.year && hasFacetPage('year', String(album.year)) ? `/metal-archive/year/${album.year}` : null;
const countrySlug = album.country ? slugify(album.country) : null;
const countryHref = countrySlug && hasFacetPage('country', countrySlug) ? `/metal-archive/country/${countrySlug}` : null;

// Country (and one placeholder genre) are stored in Spanish in the DB —
// translate for display only; slugs and queries still use the raw values.
const countryName = countryLabel(album.country);
const flag = countryFlag(album.country);
const genreName = genreLabel(album.genre);
const live = isLiveRecording(album.album_title);

// The line under the band: genre, country, tracks and length, what is known.
const metaLine = [
  genreRaw ? genreName : null,
  countryName || null,
  tracks.length > 0 ? plural(tracks.length, 'track') : null,
  album.duration_minutes ? `${album.duration_minutes} min` : null,
].filter(Boolean).join(' · ');
const tracklistNote = [
  tracks.length > 0 ? plural(tracks.length, 'track') : null,
  album.duration_minutes ? `${album.duration_minutes} min` : null,
].filter(Boolean).join(' · ');

const pageTitle = `${album.band_name} — ${album.album_title}`;
const metaDesc = `${album.band_name} · ${album.album_title}${genreName ? ' · ' + genreName : ''}${album.year ? ' · ' + album.year : ''}. Listen to the full album on the Metal Archive.`;
const ogImage = coverThumb || coverUrl;
const canonical = `https://danielbanariba.com/metal-archive/album/${album.id}`;

// ─── Player data island ──────────────────────────────────────────────────────
// The global persistent Player (rendered from the Navbar with transition:persist)
// reads this on astro:page-load to lazy-cue / switch albums. Only emitted when
// there is a playable video, so pages without one expose no #metal-np-data and
// the Player leaves any current playback untouched. videoId (above) is trimmed
// exactly like AlbumCard trims its data-video-id, so the Player's dedupe and
// "this page is the playing album" checks compare equal strings. `accent` is the
// encoded tokens the Player paints while this album is in it.
const hasVideo = videoId !== '';
const npData = hasVideo
  ? {
      videoId,
      albumId: album.id,
      youtubeUrl: album.youtube_url || '',
      ...(accent ? { accent: encodeAccent(accent) } : {}),
      albumTitle: displayTitle(album.album_title),
      bandName: album.band_name,
      coverThumb: coverThumb || coverUrl,
      // What the shell shows for it (sidebar Recent, the home hero, the bar):
      // the square crop like the cards, else the frame; and the band's page.
      cover: squareCover(album.youtube_video_id, album.album_artwork_url),
      meta: formatCardMeta(album),
      bandHref: bandHref(album.band_name),
      tracks: tracks.map((t) => ({ idx: t.idx, name: t.name, seconds: t.seconds })),
    }
  : null;

// Serialize for the inline <script type="application/json"> island. set:html does
// NOT HTML-escape, so neutralize the only sequence that could close the tag early
// ("<", e.g. a stray "</script>" inside a title) — JSON parses < as "<".
const npDataJson = npData ? JSON.stringify(npData).replace(/</g, '\\u003c') : '';

// ─── Schema.org structured data (MusicAlbum) ─────────────────────────────────
const albumJsonLd = safeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'MusicAlbum',
  '@id': `${canonical}#album`,
  name: album.album_title,
  url: canonical,
  byArtist: {
    '@type': 'MusicGroup',
    name: album.band_name,
    ...(bandSlug ? { url: `https://danielbanariba.com/metal-archive/band/${bandSlug}` } : {}),
  },
  ...(genreName ? { genre: genreName } : {}),
  ...(album.year ? { datePublished: String(album.year) } : {}),
  ...(ogImage ? { image: ogImage } : {}),
  ...(album.duration_minutes ? { duration: `PT${album.duration_minutes}M` } : {}),
  ...(album.youtube_url ? { sameAs: [album.youtube_url] } : {}),
});

// ─── The ▶ and the rows below ────────────────────────────────────────────────
// "Play album" carries the same attributes as a card's ▶, from this album's
// card projection; null without a video (nothing to play: no button).
const card = {
  id: album.id,
  band_name: album.band_name,
  album_title: album.album_title,
  genre: album.genre,
  year: album.year,
  country: album.country,
  thumb: coverThumb,
  cover: squareCover(album.youtube_video_id, album.album_artwork_url),
  youtube_video_id: album.youtube_video_id,
};
const playBtn = await playAttrs(card);
// The header's image: the square crop, else the full-size frame (sharper than
// the card's mqdefault at this size), drawn whole by CoverArt.
const heroSrc = coverMode(card.cover) === 'square' ? card.cover : coverUrl || card.cover;
---

<!doctype html>
<html lang="en" {...accentHtmlAttrs(accent)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle} · Metal Archive</title>
    <meta name="description" content={metaDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content="music.album" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDesc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={albumJsonLd} />
    <ClientRouter />
  </head>
  <body class="ma-shell ma">
    <ArchiveChrome />

    <main id="main" tabindex="-1">
      <article class="ma-album">
        <header class="ma-album__head">
          <div class="ma-album__art"><CoverArt src={heroSrc} alt={`${title} cover`} loading="eager" /></div>
          <div class="ma-album__text">
            <p class="ma-kicker">
              {live ? 'Live recording' : releaseType}{!!album.year && <><span class="ma-kicker__dot" aria-hidden="true">·</span>{album.year}</>}
            </p>
            <h1 class="ma-album__title">{title}</h1>
            <a class="ma-album__band" href={bandHref(album.band_name)}>{album.band_name}</a>
            {metaLine && <p class="ma-album__meta">{metaLine}</p>}
          </div>
          {/* One set of actions: beside the text on wider screens, under the
              cover on a phone (the grid moves it). The ▶ is a card's ▶, so it
              reads Pause only while THIS album plays, never another one. */}
          <div class="ma-album__actions">
            {playBtn && (
              <button type="button" class="ma-btn ma-btn--accent" {...playBtn} data-keep-label>
                <svg class="ma-i ma-i--fill" data-glyph viewBox="0 0 24 24" aria-hidden="true"><path d={GLYPH_PLAY} /></svg>
                <span data-label-off="Play album" data-label-on="Pause">Play album</span>
              </button>
            )}
            <button type="button" class="ma-circle ma-circle--glass" data-share aria-label="Share this album">
              <Icon name="share" />
            </button>
            {album.youtube_url && (
              <a class="ma-circle ma-circle--glass" href={album.youtube_url} target="_blank" rel="noopener noreferrer" aria-label="Open on YouTube">
                <Icon name="yt" />
              </a>
            )}
          </div>
        </header>

        <div class="ma-album__body">
          {tracks.length > 0 && (
            <section class="ma-panel ma-album__tracks" aria-labelledby="tl-h">
              <div class="ma-panel__head">
                <h2 id="tl-h">Tracklist</h2>
                {tracklistNote && <small>{tracklistNote}</small>}
              </div>
              {/* A row starts the album at that track, or seeks to it when the album
                  is already in the player (Player.tsx, [data-track-idx]). */}
              <ol class="ma-trks">
                {tracks.map((t) => (
                  <li>
                    <button
                      type="button"
                      class="ma-trk"
                      data-track-idx={String(t.idx)}
                      data-seconds={String(t.seconds)}
                      aria-label={`Play track ${t.number}: ${t.name}`}
                    >
                      <span class="ma-trk__n">
                        <span class="ma-trk__num">{t.number}</span>
                        <span class="ma-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                      </span>
                      <span class="ma-trk__name">
                        <b data-track-name="1">{t.name}</b>
                        {timed && <small>Starts at {clock(t.seconds)}</small>}
                      </span>
                      <span class="ma-trk__len">{t.length !== null ? clock(t.length) : ''}</span>
                    </button>
                  </li>
                ))}
              </ol>
            </section>
          )}

          <section class="ma-panel ma-album__details" aria-labelledby="dt-h">
            <div class="ma-panel__head"><h2 id="dt-h">Details</h2></div>
            {/* A row with a page links the whole row (the link's ::after covers it). */}
            <dl class="ma-info">
              <div class="ma-info__row">
                <Icon name="user" />
                <dt>Band</dt>
                <dd><a href={bandHref(album.band_name)}>{album.band_name}</a></dd>
                <Icon name="right" class="ma-info__chev" />
              </div>
              {!!album.year && (
                <div class="ma-info__row">
                  <Icon name="calendar" />
                  <dt>Year</dt>
                  <dd>{yearHref ? <a href={yearHref}>{album.year}</a> : album.year}</dd>
                  {yearHref ? <Icon name="right" class="ma-info__chev" /> : <span />}
                </div>
              )}
              <div class="ma-info__row">
                <Icon name="genres" />
                <dt>Genre</dt>
                <dd>{genreRaw ? (genreHref ? <a href={genreHref}>{genreName}</a> : genreName) : <span class="ma-muted">Not listed</span>}</dd>
                {genreHref ? <Icon name="right" class="ma-info__chev" /> : <span />}
              </div>
              <div class="ma-info__row">
                <Icon name="globe" />
                <dt>Country</dt>
                <dd>
                  {countryName
                    ? (countryHref
                        ? <a href={countryHref}>{flag && <span aria-hidden="true">{flag} </span>}{countryName}</a>
                        : <>{flag && <span aria-hidden="true">{flag} </span>}{countryName}</>)
                    : <span class="ma-muted">Not listed</span>}
                </dd>
                {countryHref ? <Icon name="right" class="ma-info__chev" /> : <span />}
              </div>
              {(!!album.duration_minutes || tracks.length > 0) && (
                <div class="ma-info__row">
                  <Icon name="clock" />
                  <dt>Duration</dt>
                  <dd>{tracklistNote}</dd>
                  <span />
                </div>
              )}
              {formatUploadDay(album.upload_date) && (
                <div class="ma-info__row">
                  <Icon name="upload" />
                  <dt>Uploaded</dt>
                  <dd>{formatUploadDay(album.upload_date)}</dd>
                  <span />
                </div>
              )}
              <div class="ma-info__row">
                <Icon name="eye" />
                <dt>Views</dt>
                <dd>{(album.views ?? 0).toLocaleString('en-US')} on YouTube</dd>
                <span />
              </div>
            </dl>
            {/* Streaming / social links, pulled from the description + DB. */}
            {platformLinks.length > 0 && (
              <ul class="ma-album__links" aria-label="Listen and follow elsewhere">
                {platformLinks.map((l) => (
                  <li>
                    <a class="ma-pill" href={l.url} target="_blank" rel="noopener noreferrer">
                      <span class="ma-album__link-ico" set:html={platformIcon(l.label)}></span>{l.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        </div>

        <div class="ma-album__rows">
          {moreFromBand.length > 0 && (
            <Row
              id="more-from-band"
              title={`More from ${album.band_name}`}
              more={bandSlug ? { label: 'Band page', href: `/metal-archive/band/${bandSlug}` } : undefined}
            >
              {moreFromBand.map((a) => <AlbumCard album={a} livePlaceholder={isLiveRecording(a.album_title)} />)}
            </Row>
          )}

          {similarBands.length > 0 && (
            <section class="ma-row ma-album__similar" aria-labelledby="similar-bands-h">
              <div class="ma-row__head"><h2 class="ma-row__title" id="similar-bands-h">Similar bands</h2></div>
              <ul class="ma-pills">
                {similarBands.map((b) => <li><a class="ma-pill" href={bandHref(b.band_name)}>{b.band_name}</a></li>)}
              </ul>
            </section>
          )}

          {similarAlbums.length > 0 && (
            <Row id="similar" title="If you liked this">
              {similarAlbums.map((a) => <AlbumCard album={a} />)}
            </Row>
          )}

          {moreToExplore.length > 0 && (
            <Row id="explore" title="Keep exploring" more={{ label: 'See all', href: '/metal-archive/browse?sort=newest' }}>
              {moreToExplore.map((a) => <AlbumCard album={a} />)}
            </Row>
          )}
        </div>
      </article>
    </main>

    <!-- ─── Player data island ─────────────────────────────────────────────── -->
    <!-- Read by the global persistent <Player> (rendered in the Navbar) on
         astro:page-load to lazy-cue this album and to switch to it on play.
         NOT persisted: it must be REPLACED on every navigation so the Player
         sees the new page's album. type="application/json" is inert data (not an
         executable script), so ClientRouter simply swaps it in with the page.
         Only emitted when there is a playable video. -->
    {npData && (
      <script
        type="application/json"
        id="metal-np-data"
        is:inline
        set:html={npDataJson}
      />
    )}

    <Footer />
  </body>
</html>
