---
// Album detail page, "the dark room" (premium redesign, 2026). One static page
// per album (1298 total).
//
// A header band in the album's own colour (cover lit on the left, title, band,
// facts, actions), then the tracklist as a table, then what to play next.
//
// Build-time work in the frontmatter:
//   - getAlbum / getTracks / getSimilarBands / getSimilarAlbums / getAlbumsByBand
//   - parse each track timestamp ("MM:SS" / "HH:MM:SS") to seconds; every album is
//     ONE long video and a timestamp is where a track STARTS, so a track's length
//     is the gap to the next start
//   - getAlbumColor() extracts the dominant swatch from the thumb (cached); the
//     header field is that colour mixed down into the dark ground (see fieldFor)
//
// Interactivity lives in the GLOBAL persistent <Player> (rendered from the
// Navbar, transition:persist). This page only exposes its album as a JSON data
// island (#metal-np-data) that the Player reads on astro:page-load, and marks the
// Play button (`data-np-main`, `.js-pp`) and the track rows (`data-track-idx`,
// `data-seconds`, `[data-track-name]`) the Player's delegated click handler finds.
import {
  getAllAlbumIds,
  getAlbum,
  getTracks,
  getSimilarBands,
  getSimilarAlbums,
  getAlbumsByBand,
  getBandAlbumCount,
  getBandPageNameSet,
  isLiveRecording,
  slugify,
} from '../../../lib/db.js';
import { countryLabel, genreLabel } from '../../../lib/labels.js';
import { thumb } from '../../../lib/thumb.js';
import { getAlbumColor } from '../../../lib/vibrant.js';
import { safeJsonLd } from '../../../lib/seo.js';
import { ClientRouter } from 'astro:transitions';
import Carousel from '../../../components/Carousel.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import ArchiveHead from '../../../components/ArchiveHead.astro';
import Reveal from '../../../components/Reveal.astro';
import '../../../styles/global.css';

export function getStaticPaths() {
  // NOTE: db helpers are imported at module scope, but Astro compiles
  // getStaticPaths into a separate prerender chunk. Re-import inside to be safe
  // is not needed for imported bindings (they resolve fine); only frontmatter
  // *local functions* are unavailable here. getAllAlbumIds is a module import.
  const ids = getAllAlbumIds();
  return ids.map((id) => ({ params: { id: String(id) } }));
}

const id = Number(Astro.params.id);
const album = getAlbum(id);

// Astro static build: a missing album would be a build-time data bug, not a
// runtime 404. getStaticPaths only emits real IDs, so album is always present.
if (!album) {
  throw new Error(`Album ${id} not found at build time`);
}

const rawTracks = getTracks(id);
const similarBands = getSimilarBands(id);
const similarAlbums = getSimilarAlbums(album.genre, id);

// Names of bands that have their own page (2+ albums), built from a single query
// so each "Similar bands" chip can resolve its destination without an N+1.
// A chip links to the band page when it exists, else to a Browse text search so
// the discovery jump always lands somewhere.
const bandPageNames = getBandPageNameSet();
function similarBandHref(name: string): string {
  return bandPageNames.has(name)
    ? `/metal-archive/band/${slugify(name)}`
    : `/metal-archive/browse?q=${encodeURIComponent(name)}`;
}

// ─── Parse "MM:SS" / "HH:MM:SS" timestamps to seconds (build-time) ───────────
function tsToSeconds(ts: string | null): number {
  if (!ts) return 0;
  const parts = ts.split(':').map((p) => parseInt(p, 10));
  if (parts.some((n) => Number.isNaN(n))) return 0;
  if (parts.length === 3) return parts[0] * 3600 + parts[1] * 60 + parts[2];
  if (parts.length === 2) return parts[0] * 60 + parts[1];
  if (parts.length === 1) return parts[0];
  return 0;
}

function clock(total: number): string {
  const h = Math.floor(total / 3600);
  const m = Math.floor((total % 3600) / 60);
  const s = Math.floor(total % 60);
  const ss = String(s).padStart(2, '0');
  return h > 0 ? `${h}:${String(m).padStart(2, '0')}:${ss}` : `${m}:${ss}`;
}

const tracks = rawTracks.map((t, i) => ({
  idx: i,
  number: t.track_number ?? i + 1,
  name: t.track_name,
  seconds: tsToSeconds(t.timestamp),
}));

// Track lengths. A timestamp is where a track starts inside the one long video, so a
// length is the gap to the next start. The last track runs to the end of the video,
// whose length is only known to the minute (duration_minutes is rounded), so that one
// is an estimate. Without strictly rising starts no length can be told: show none.
const albumSeconds = (album.duration_minutes ?? 0) * 60;
const risingStarts = tracks.every((t, i) => i === 0 || t.seconds > tracks[i - 1].seconds);
const trackLengths = tracks.map((t, i) => {
  if (tracks.length === 1) return albumSeconds;
  if (!risingStarts) return 0;
  if (i + 1 < tracks.length) return tracks[i + 1].seconds - t.seconds;
  return albumSeconds - t.seconds >= 15 ? albumSeconds - t.seconds : 0;
});

// ─── Artwork ─────────────────────────────────────────────────────────────────
const coverUrl = album.album_artwork_url || '';
const coverThumb = thumb(album.album_artwork_url);

// ─── Build-time colour: the header field ─────────────────────────────────────
// Use the small thumb (mqdefault) — Vibrant decodes every pixel, the thumb is
// ~16x cheaper than the full cover and yields an identical dominant color.
// Pass the full cover as a fallback: if the thumb 404s or is an undecodable
// format, getAlbumColor tries the large image before returning the default
// (deathgrind .webp covers in particular need the full-bytes -> sharp path).
const albumColor = await getAlbumColor(coverThumb || coverUrl, coverUrl);

// Same capped mix as the home hero (index.astro fieldFor): bone type (#ece6da) sits
// on a flat field tinted by the album's own colour. The album share is capped at 30%,
// so the field is always a dark, album-tinted surface and never a mid-tone, and is
// stepped down further until the type reads at >= 8:1.
const INK: [number, number, number] = [0xec, 0xe6, 0xda];
const GROUND: [number, number, number] = [0x0e, 0x0d, 0x0c];
const lin = (c: number) => { const s = c / 255; return s <= 0.04045 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4; };
const lum = (c: number[]) => 0.2126 * lin(c[0]) + 0.7152 * lin(c[1]) + 0.0722 * lin(c[2]);
const ratio = (a: number[], b: number[]) => { const [x, y] = lum(a) > lum(b) ? [a, b] : [b, a]; return (lum(x) + 0.05) / (lum(y) + 0.05); };
const mixRgb = (a: number[], b: number[], t: number) => a.map((v, i) => Math.round(v * t + b[i] * (1 - t)));
const toHex = (c: number[]) => '#' + c.map((v) => ('0' + v.toString(16)).slice(-2)).join('');
function fieldFor(hex: string): string {
  const m = /^#?([0-9a-f]{6})$/i.exec(hex || '');
  const rgb = m ? [0, 2, 4].map((i) => parseInt(m[1].slice(i, i + 2), 16)) : [0xdd, 0xa1, 0x5e];
  for (let t = 0.3; t >= 0.08; t -= 0.02) {
    const f = mixRgb(rgb, GROUND, t);
    if (ratio(INK, f) >= 8 && lum(f) <= 0.024) return toHex(f);
  }
  return toHex(mixRgb(rgb, GROUND, 0.08));
}
const field = fieldFor(albumColor);

// ─── Streaming / social links ────────────────────────────────────────────────
// Many descriptions are scraped text that embeds the band's links (Bandcamp,
// Spotify, Metal Archives, socials…). We pull every URL out of the description
// AND the dedicated DB columns, classify each by platform, and render them as
// icon buttons instead of dumping the raw text. Deduped by platform.
const LINK_PLATFORMS: { test: RegExp; label: string }[] = [
  { test: /bandcamp\.com/i, label: 'Bandcamp' },
  { test: /spotify\.com/i, label: 'Spotify' },
  { test: /music\.apple\.com|itunes\.apple\.com/i, label: 'Apple Music' },
  { test: /metal-archives\.com/i, label: 'Metal Archives' },
  { test: /facebook\.com|fb\.com/i, label: 'Facebook' },
  { test: /instagram\.com/i, label: 'Instagram' },
  { test: /soundcloud\.com/i, label: 'SoundCloud' },
  { test: /deezer\.com/i, label: 'Deezer' },
  { test: /tidal\.com/i, label: 'Tidal' },
  { test: /(twitter\.com|x\.com)/i, label: 'Twitter / X' },
  { test: /tiktok\.com/i, label: 'TikTok' },
  { test: /youtube\.com|youtu\.be/i, label: 'YouTube' },
];
function classifyLink(url: string): string {
  for (const p of LINK_PLATFORMS) if (p.test.test(url)) return p.label;
  try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return 'Link'; }
}
const dbLinkUrls = [
  album.spotify_url, album.bandcamp_url, album.apple_music_url,
  album.metal_archives_url, album.facebook_url, album.instagram_url,
].filter((u): u is string => !!u && u.trim() !== '');
const descUrls = (album.description || '').match(/https?:\/\/[^\s)<>"']+/g) || [];
const allLinkUrls = [...new Set([...dbLinkUrls, ...descUrls].map((u) => u.replace(/[.,;]+$/, '').trim()))];
const seenPlatform = new Set<string>();
// Drop links back to our own site(s) — those aren't external platforms.
const SELF_DOMAINS = /(danielbanariba\.com|xeroxunderground\.com)/i;
const platformLinks = allLinkUrls
  .map((url) => ({ label: classifyLink(url), url }))
  .filter((l) => l.label !== 'YouTube')        // YouTube already has its own button in the header
  .filter((l) => !SELF_DOMAINS.test(l.url))     // remove our own website (danielbanariba.com)
  .filter((l) => { if (seenPlatform.has(l.label)) return false; seenPlatform.add(l.label); return true; });

// Brand logos for each link button (monochrome, currentColor). Best-effort
// single-path marks; platforms without a real logo fall back to a globe.
function platformIcon(label: string): string {
  const wrap = (inner: string, opts = '') =>
    `<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" ${opts}>${inner}</svg>`;
  switch (label) {
    case 'Spotify':
      return wrap('<path fill="currentColor" d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.52 17.34c-.24.36-.66.48-1.02.24-2.82-1.74-6.36-2.1-10.56-1.14-.42.12-.78-.18-.9-.54-.12-.42.18-.78.54-.9 4.56-1.02 8.52-.6 11.64 1.32.42.18.48.66.3 1.02zm1.44-3.3c-.3.42-.84.6-1.26.3-3.24-1.98-8.16-2.58-11.94-1.38-.48.12-1.02-.12-1.14-.6-.12-.48.12-1.02.6-1.14C9.6 9.9 15 10.56 18.72 12.84c.36.18.54.78.24 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.3c-.6.18-1.2-.18-1.38-.72-.18-.6.18-1.2.72-1.38 4.26-1.26 11.28-1.02 15.72 1.62.54.3.72 1.02.42 1.56-.3.42-1.02.6-1.56.3z"/>');
    case 'Bandcamp':
      return wrap('<path fill="currentColor" d="M0 18.75l7.44-13.5H24l-7.44 13.5H0z"/>');
    case 'Apple Music':
      return wrap('<path fill="currentColor" d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>');
    case 'Facebook':
      return wrap('<path fill="currentColor" d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07c0 6 4.39 10.97 10.13 11.85v-8.38H7.08v-3.47h3.04V9.43c0-3 1.79-4.66 4.53-4.66 1.31 0 2.68.23 2.68.23v2.95H15.8c-1.49 0-1.95.92-1.95 1.87v2.25h3.32l-.53 3.47h-2.79v8.38C19.6 23.04 24 18.07 24 12.07z"/>');
    case 'Instagram':
      return wrap('<path fill="currentColor" d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85C2.38 3.93 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16zm0-2.16C8.74 0 8.33.01 7.05.07 2.7.27.28 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.41-10.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"/>');
    case 'Twitter / X':
      return wrap('<path fill="currentColor" d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.66l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.01 4.13H5.04l12.04 15.64z"/>');
    case 'SoundCloud':
      return wrap('<path fill="currentColor" d="M1.2 12.6c-.07 0-.12.05-.13.12L.9 14.46l.17 1.71c.01.07.06.12.13.12.06 0 .12-.05.12-.12l.2-1.71-.2-1.74c0-.07-.06-.12-.12-.12zm12.9 1.86l.28-.06c.4-.02.74.32.74.74 0 .42-.34.76-.76.76h-4.6V9.6c.5-.3 1.08-.46 1.7-.46 1.78 0 3.22 1.4 3.3 3.16.18-.08.38-.12.59-.12.5 0 .9.4.9.9 0 .12-.02.23-.06.34M9.7 9.54l-.25 4.16.25 1.65c.01.13.12.24.25.24.13 0 .24-.1.25-.24l.28-1.65-.28-4.16c-.01-.13-.12-.24-.25-.24-.13 0-.24.1-.25.24zm-2.08.62l-.22 3.54.22 1.66c.01.13.12.23.26.23.13 0 .24-.1.25-.23l.25-1.66-.25-3.54c-.01-.13-.12-.23-.25-.23-.14 0-.25.1-.26.23z"/>');
    case 'Deezer':
      return wrap('<g fill="currentColor"><rect x="16.5" y="6.6" width="7.5" height="2.3"/><rect x="16.5" y="10" width="7.5" height="2.3"/><rect x="8.25" y="13.4" width="7.5" height="2.3"/><rect x="16.5" y="13.4" width="7.5" height="2.3"/><rect x="0" y="16.8" width="7.5" height="2.3"/><rect x="8.25" y="16.8" width="7.5" height="2.3"/><rect x="16.5" y="16.8" width="7.5" height="2.3"/></g>');
    default:
      return wrap('<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/>', 'fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"');
  }
}

// ─── Discovery links (genre / year / band) ────────────────────────────────────
const genreSlug = album.genre ? slugify(album.genre) : null;
const bandAlbumCount = getBandAlbumCount(album.band_name);
const bandSlug = bandAlbumCount >= 2 ? slugify(album.band_name) : null;
// #4: bandSlug is only set when this EXACT casing has 2+ albums (getBandAlbumCount is
// a plain band_name = ?), so a band entered with inconsistent casing across uploads
// would be dead text with no way to find its other releases. Fall back to the same
// Browse-search link the "Similar bands" chips use when a band has no page.
const bandHref = bandSlug ? `/metal-archive/band/${bandSlug}` : similarBandHref(album.band_name);

// Other albums by this band. A live set only sits beside other live sets, and a studio
// album beside studio albums, the same split the home feeds make (isLiveRecording).
const bandMore = getAlbumsByBand(album.band_name).filter(
  (a) => a.id !== album.id && isLiveRecording(a.album_title) === isLiveRecording(album.album_title),
);

// Country (and one placeholder genre) are stored in Spanish in the DB —
// translate for display only; slugs and queries still use the raw values.
const countryName = countryLabel(album.country);
const genreName = genreLabel(album.genre);

// ─── Title ───────────────────────────────────────────────────────────────────
// Long tails ("(Live in Honduras, Tegucigalpa - October 3, 2019)", "[Remastered]") sit
// under the name at a smaller size, inside the same <h1>. The name's size is set from
// how it wraps (--cc), so it holds on two lines at every width; see .album-head__title.
const titleParts = /^(.{4,}?)\s+([(\[].+)$/.exec(album.album_title);
const titleMain = titleParts ? titleParts[1] : album.album_title;
const titleSub = titleParts ? titleParts[2] : '';
// How many characters the widest of the two lines holds when the name is split at the best
// word boundary (one word: the word itself). The CSS turns it into a font size that keeps the
// name on two lines in any column width. Erode has no Cyrillic or CJK, so those fall back to
// a wider face (1.3). Capitals run wider than lowercase (1.2), m and w wider still (1.5),
// i, l, j and punctuation narrower (0.55); a space counts 0.45.
const charWeight = (c: string) =>
  /[^\u0000-\u024F]/.test(c) ? 1.3
  : /[mwMW]/.test(c) ? (c === c.toUpperCase() ? 1.6 : 1.5)
  : /[ijl.,'!:;|]/.test(c) ? 0.55
  : /[tfrI]/.test(c) ? 0.75
  : /\p{Lu}/u.test(c) ? 1.2 : 1;
const wordWeight = (w: string) => [...w.normalize('NFD').replace(/\p{M}/gu, '')].reduce((n, c) => n + charWeight(c), 0);
function lineChars(name: string): number {
  const w = name.split(/\s+/).filter(Boolean).map(wordWeight);
  if (w.length < 2) return Math.max(1, w[0] ?? 1);
  let best = Infinity;
  for (let k = 1; k < w.length; k++) {
    const first = w.slice(0, k).reduce((n, x) => n + x, 0) + 0.45 * (k - 1);
    const rest = w.slice(k).reduce((n, x) => n + x, 0) + 0.45 * (w.length - k - 1);
    best = Math.min(best, Math.max(first, rest));
  }
  return Math.ceil(best * 10) / 10;
}
const titleChars = lineChars(titleMain);

// ─── Facts line: genre · country · year · tracks · length · views ────────────
const nf = new Intl.NumberFormat('en-US');
const compact = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });
const releaseType = album.release_type && !/^(full album|album)?$/i.test(album.release_type.trim()) ? album.release_type.trim() : '';
const lengthText = album.duration_minutes
  ? (album.duration_minutes >= 60
      ? `${Math.floor(album.duration_minutes / 60)} h${album.duration_minutes % 60 ? ` ${album.duration_minutes % 60} min` : ''}`
      : `${album.duration_minutes} min`)
  : '';
// year 0 means "unknown"; a bare `0 && ...` would render a literal "0" (see lib/cardMeta.ts).
const facts: { text: string; href?: string }[] = [
  releaseType ? { text: releaseType } : null,
  genreName ? { text: genreName, href: genreSlug ? `/metal-archive/genre/${genreSlug}` : undefined } : null,
  countryName ? { text: countryName } : null,
  album.year ? { text: String(album.year), href: `/metal-archive/year/${album.year}` } : null,
  tracks.length > 0 ? { text: `${nf.format(tracks.length)} ${tracks.length === 1 ? 'track' : 'tracks'}` } : null,
  lengthText ? { text: lengthText } : null,
  album.views > 0 ? { text: `${album.views < 1000 ? nf.format(album.views) : compact.format(album.views)} ${album.views === 1 ? 'view' : 'views'}` } : null,
].filter((f): f is { text: string; href?: string } => f !== null);

const pageTitle = `${album.band_name} — ${album.album_title}`;
const metaDesc = `${album.band_name} · ${album.album_title}${genreName ? ' · ' + genreName : ''}${album.year ? ' · ' + album.year : ''}. Listen to the full album on the Metal Archive.`;
const ogImage = coverThumb || coverUrl;
const canonical = `https://danielbanariba.com/metal-archive/album/${album.id}`;

// ─── Player data island ──────────────────────────────────────────────────────
// The global persistent Player (rendered from the Navbar with transition:persist)
// reads this on astro:page-load to lazy-cue / switch albums. Only emitted when
// there is a playable video, so pages without one expose no #metal-np-data and
// the Player leaves any current playback untouched.
const hasVideo = !!(album.youtube_video_id && album.youtube_video_id.trim() !== '');
const npData = hasVideo
  ? {
      videoId: album.youtube_video_id,
      youtubeUrl: album.youtube_url || '',
      albumColor,
      albumTitle: album.album_title,
      bandName: album.band_name,
      coverThumb: coverThumb || coverUrl,
      tracks: tracks.map((t) => ({ idx: t.idx, name: t.name, seconds: t.seconds })),
    }
  : null;

// Serialize for the inline <script type="application/json"> island. set:html does
// NOT HTML-escape, so neutralize the only sequence that could close the tag early
// ("<", e.g. a stray "</script>" inside a title) — JSON parses < as "<".
const npDataJson = npData ? JSON.stringify(npData).replace(/</g, '\\u003c') : '';

// ─── Schema.org structured data (MusicAlbum) ─────────────────────────────────
const albumJsonLd = safeJsonLd({
  '@context': 'https://schema.org',
  '@type': 'MusicAlbum',
  '@id': `${canonical}#album`,
  name: album.album_title,
  url: canonical,
  byArtist: {
    '@type': 'MusicGroup',
    name: album.band_name,
    ...(bandSlug ? { url: `https://danielbanariba.com/metal-archive/band/${bandSlug}` } : {}),
  },
  ...(genreName ? { genre: genreName } : {}),
  ...(album.year ? { datePublished: String(album.year) } : {}),
  ...(ogImage ? { image: ogImage } : {}),
  ...(album.duration_minutes ? { duration: `PT${album.duration_minutes}M` } : {}),
  ...(album.youtube_url ? { sameAs: [album.youtube_url] } : {}),
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle} · Metal Archive</title>
    <meta name="description" content={metaDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content="music.album" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDesc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={albumJsonLd} />
    <ArchiveHead />
    <ClientRouter />
  </head>
  <body class="ma">
    <Navbar />

    <main id="main" tabindex="-1">
      <!-- ─── Header band: the cover lit on a field of its own colour ─────────── -->
      <header class="album-head" style={`--field: ${field}; --album: ${albumColor};`}>
        <div class="album-head__inner">
          <div class="album-head__cover">
            {coverUrl
              ? <img
                  src={coverUrl}
                  alt={`Cover of ${album.album_title} by ${album.band_name}`}
                  width="1280"
                  height="720"
                  fetchpriority="high"
                  decoding="async"
                />
              : <div class="album-head__cover-empty" aria-hidden="true"></div>
            }
          </div>

          <div class="album-head__text" style={`--cc:${titleChars};`}>
            <h1 class="album-head__title rise" id="album-title" style="--i:0">
              <span class="album-head__name">{titleMain}</span>
              {titleSub && <>{' '}<span class="album-head__sub">{titleSub}</span></>}
            </h1>
            <p class="album-head__band rise" style="--i:1"><a href={bandHref}>{album.band_name}</a></p>
            <ul class="album-head__facts rise" style="--i:2" aria-label="Album details">
              {facts.map((f) => <li>{f.href ? <a href={f.href}>{f.text}</a> : f.text}</li>)}
            </ul>

            <div class="album-head__actions rise" style="--i:3">
              {hasVideo && (
                <button type="button" class="btn btn--primary album-head__play js-pp" aria-label="Play or pause" data-np-main="1" data-state="paused">
                  <svg class="ic ic-play" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
                  <svg class="ic ic-pause" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM14 5h4v14h-4z"/></svg>
                  <span class="ic ic-spinner" aria-hidden="true"></span>
                  <span class="pp-lbl pp-lbl--play">Play</span>
                  <span class="pp-lbl pp-lbl--pause">Pause</span>
                  <span class="pp-lbl pp-lbl--wait">Loading</span>
                </button>
              )}
              {album.youtube_url && (
                <a class="btn btn--secondary" href={album.youtube_url} target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M23 12s0-3.8-.5-5.6a3 3 0 0 0-2.1-2.1C18.6 3.8 12 3.8 12 3.8s-6.6 0-8.4.5A3 3 0 0 0 1.5 6.4C1 8.2 1 12 1 12s0 3.8.5 5.6a3 3 0 0 0 2.1 2.1c1.8.5 8.4.5 8.4.5s6.6 0 8.4-.5a3 3 0 0 0 2.1-2.1C23 15.8 23 12 23 12zM10 15.5v-7l6 3.5z"/></svg>
                  <span>YouTube</span>
                </a>
              )}
              <button type="button" class="btn btn--secondary" data-share="1" aria-label="Share this album">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.6" y1="13.5" x2="15.4" y2="17.5"/><line x1="15.4" y1="6.5" x2="8.6" y2="10.5"/></svg>
                <span>Share</span>
              </button>
              {/* Streaming / social links: brand logos, pulled from the description + DB */}
              {platformLinks.length > 0 && (
                <ul class="album-head__links" aria-label="Also on">
                  {platformLinks.map((l) => (
                    <li>
                      <a class="icon-btn" href={l.url} target="_blank" rel="noopener noreferrer" aria-label={`${l.label} (opens in a new tab)`} title={l.label} set:html={platformIcon(l.label)}></a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </div>
      </header>

      <!-- ─── Tracklist: a real ordered list, one button per row ─────────────── -->
      {tracks.length > 0 && (
        <section class="sect tracks" aria-labelledby="tracks-title" data-reveal>
          <h2 class="sect-title rv" id="tracks-title" style="--i:0">Tracklist</h2>
          <ol class="tl">
            {tracks.map((t, i) => (
              <li class="rv" style={`--i:${Math.min(i, 9) + 1}`}>
                <button
                  type="button"
                  class="tl__row"
                  data-track-idx={String(t.idx)}
                  data-seconds={String(t.seconds)}
                  aria-label={`Play track ${t.number}: ${t.name}`}
                  disabled={!hasVideo}
                >
                  <span class="tl__n"><span class="tl__num">{t.number}</span><span class="tl__eq" aria-hidden="true"><i></i><i></i><i></i></span></span>
                  <span class="tl__t" data-track-name="1">{t.name}</span>
                  <span class="tl__d">{trackLengths[i] > 0 ? clock(trackLengths[i]) : ''}</span>
                </button>
              </li>
            ))}
          </ol>
        </section>
      )}

      <!-- ─── What to play next ──────────────────────────────────────────────── -->
      {bandMore.length > 0 && (
        <Carousel id="band-more" title="More from the band" albums={bandMore} href={bandSlug ? bandHref : undefined} hrefLabel="See all" deferred />
      )}
      {similarAlbums.length > 0 && (
        <Carousel id="similar-albums" title="Similar albums" albums={similarAlbums} deferred />
      )}

      {similarBands.length > 0 && (
        <section class="sect similar" aria-labelledby="similar-title" data-reveal>
          <h2 class="sect-title rv" id="similar-title" style="--i:0">Similar bands</h2>
          <ul class="chips rv" style="--i:1">
            {similarBands.map((b) => (
              <li><a class="chip" href={similarBandHref(b.band_name)}>{b.band_name}</a></li>
            ))}
          </ul>
        </section>
      )}
    </main>

    <!-- ─── Player data island ─────────────────────────────────────────────── -->
    <!-- Read by the global persistent <Player> (rendered in the Navbar) on
         astro:page-load to lazy-cue this album and to switch to it on play.
         NOT persisted: it must be REPLACED on every navigation so the Player
         sees the new page's album. type="application/json" is inert data (not an
         executable script), so ClientRouter simply swaps it in with the page.
         Only emitted when there is a playable video. -->
    {npData && (
      <script
        type="application/json"
        id="metal-np-data"
        is:inline
        set:html={npDataJson}
      />
    )}

    <Footer cover={coverUrl || undefined} />
    <Reveal />
  </body>
</html>
