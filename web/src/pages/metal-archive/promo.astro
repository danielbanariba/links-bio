---
// promo.astro — Promote music on the Metal Archive
// POSTs to /api/metal-archive/promo (FastAPI on port 8001, proxied by host)
//
// The dark room (premium redesign, 2026): the shared head, then two columns on a desktop, the
// argument on the left (how it works, the archive's real numbers, and a recent upload as it is
// published) and the form on the right; on a phone the argument comes first.
import { ClientRouter } from 'astro:transitions';
import { getLatestUploads } from '../../lib/db.js';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ArchiveHead from '../../components/ArchiveHead.astro';
import PageHead from '../../components/PageHead.astro';
import Reveal from '../../components/Reveal.astro';
import Carousel from '../../components/Carousel.astro';
import FormFacts from '../../components/FormFacts.astro';
import '../../styles/global.css';

const GENRES = [
  "Death Metal", "Black Metal", "Thrash Metal", "Doom Metal",
  "Grindcore", "Power Metal", "Heavy Metal", "Melodic Death Metal",
  "Grind/Death Metal", "Punk Rock", "Metalcore", "Progressive Metal",
  "Folk Metal", "Symphonic Metal", "Sludge Metal", "Stoner Metal",
  "Speed Metal", "Brutal Death Metal",
];

// ── Promote packages (STATIC MOCKUP) ────────────────────────────────────────
// OWNER CONTENT PENDING: every price, tier name, delivery time and inclusion
// list below is a PLACEHOLDER. Daniel must define the real packages before this
// page goes live. Do NOT invent amounts, currencies or delivery times.
//
// Each package's `value` is what gets submitted in the "Package of interest"
// <select>. It is sent to the backend as `release_format`, which /promo maps to
// ContactMessage.package_interest (verified in links_bio/fastapi_forms.py).
// Keep `value` stable/identifiable even while the labels are placeholders.
const PACKAGES = [
  {
    value: "Basic Package",
    // OWNER CONTENT PENDING: real tier name
    name: "Basic Package",
    // OWNER CONTENT PENDING: real price (e.g. "From $X")
    price: "Price TBD",
    // OWNER CONTENT PENDING: confirm real inclusions per tier
    includes: [
      "Video with cover art and tracklist",
      "Published on YouTube",
      "Entry in the Metal Archive",
    ],
    // OWNER CONTENT PENDING: real delivery time
    delivery: "Delivery time: TBD",
    featured: false,
  },
  {
    value: "Standard Package",
    // OWNER CONTENT PENDING: real tier name
    name: "Standard Package",
    // OWNER CONTENT PENDING: real price (e.g. "From $X")
    price: "Price TBD",
    // OWNER CONTENT PENDING: confirm real inclusions per tier
    includes: [
      "Everything in the Basic package",
      "Animated audio spectrum",
      "Social media promotion",
    ],
    // OWNER CONTENT PENDING: real delivery time
    delivery: "Delivery time: TBD",
    featured: true,
  },
  {
    value: "Premium Package",
    // OWNER CONTENT PENDING: real tier name
    name: "Premium Package",
    // OWNER CONTENT PENDING: real price (e.g. "From $X")
    price: "Price TBD",
    // OWNER CONTENT PENDING: confirm real inclusions per tier
    includes: [
      "Everything in the Standard package",
      "Wider reach and publishing priority",
      "Extended social media coverage",
    ],
    // OWNER CONTENT PENDING: real delivery time
    delivery: "Delivery time: TBD",
    featured: false,
  },
];

// Flag: while false, the placeholder packages section AND the "Package of interest"
// select stay HIDDEN, so visitors never see "Price TBD". Flip to true once
// PACKAGES holds real prices/tiers (OWNER CONTENT — see comments above).
const PACKAGES_READY = false;

// A recent upload, whole, is what the video looks like once published (the thumbnail of every
// upload is its cover art beside the printed tracklist). The shelf below starts after it.
const uploads = getLatestUploads(9);
const frame = uploads[0];
const latest = uploads.slice(1);

// The field of the head: a warm neutral, mixed down into the ground by PageHead (as Browse).
const HEAD_COLOR = '#8c8478';

const pageTitle = 'Promote your music | Metal Archive';
const metaDesc = 'Promote your band, album or label to an extreme metal audience.';
const canonical = 'https://danielbanariba.com/metal-archive/promo';
const ogImage = 'https://danielbanariba.com/avatar.jpg';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDesc} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDesc} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDesc} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="canonical" href={canonical} />
  <ArchiveHead />
  <ClientRouter />
</head>
<body class="ma">
  <Reveal />
  <Navbar />

  <main id="main" tabindex="-1">
    <PageHead title="Promote your music" color={HEAD_COLOR} split>
      <p class="page-head__lead rise" style="--i:1">Reach an extreme metal audience with your band, album or label through the Metal Archive.</p>
      <a class="btn btn--secondary fm-jump rise" style="--i:2" href="#form-title">Go to the form</a>
    </PageHead>

    {/* Packages (STATIC MOCKUP — OWNER CONTENT PENDING). Hidden until
        PACKAGES_READY is true, so visitors never see placeholder prices.
        Do NOT invent prices, currencies or delivery times. Read as one comparison:
        a row per package, the same four columns, so the listener reads across. */}
    {PACKAGES_READY && (
    <section class="sect fm-packages" aria-labelledby="packages-title" data-reveal>
      <h2 class="sect-title rv" id="packages-title" style="--i:0">Choose your package</h2>
      <p class="sect-lead rv" style="--i:1">Prices and delivery times are provisional. They are still being finalised.</p>
      <table class="pkg rv" style="--i:2">
        <caption class="sr-only">Promotion packages compared</caption>
        <thead>
          <tr>
            <th scope="col">Package</th>
            <th scope="col">Price</th>
            <th scope="col">Delivery</th>
            <th scope="col">Includes</th>
          </tr>
        </thead>
        <tbody>
          {PACKAGES.map(pkg => (
            <tr>
              <th scope="row" class="pkg__name">{pkg.name}</th>
              {/* OWNER CONTENT PENDING: real price */}
              <td data-label="Price">{pkg.price}</td>
              {/* OWNER CONTENT PENDING: real delivery time */}
              <td data-label="Delivery">{pkg.delivery}</td>
              <td data-label="Includes">
                <ul class="pkg__includes">
                  {pkg.includes.map(item => <li>{item}</li>)}
                </ul>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
    )}

    <div class="fm">
      <!-- The argument: how it works, the archive's numbers, a recent upload as published -->
      <section class="fm-aside" data-reveal aria-labelledby="how-title">
        <h2 class="fm-title rv" id="how-title" style="--i:0">How does it work?</h2>
        <ol class="fm-steps rv" style="--i:1">
          <li>
            <strong class="fm-steps__name">We review your submission</strong>
            <span class="fm-steps__text">We listen to your music and verify the details.</span>
          </li>
          <li>
            <strong class="fm-steps__name">We produce the video</strong>
            <span class="fm-steps__text">We build the video with the cover art, the tracklist and the audio spectrum.</span>
          </li>
          <li>
            <strong class="fm-steps__name">We publish it</strong>
            <span class="fm-steps__text">Your album goes live on YouTube and in the Metal Archive.</span>
          </li>
        </ol>
        <div class="rv" style="--i:2">
          <FormFacts lead="Your release goes up next to" />
        </div>
        {frame && (
          <figure class="fm-frame rv" style="--i:3">
            <a href={`/metal-archive/album/${frame.id}`}>
              <img src={frame.cover} alt={`${frame.band_name}, ${frame.album_title}`} width="1280" height="720" loading="lazy" decoding="async" />
            </a>
            <figcaption>{frame.band_name}, {frame.album_title}: a recent upload, with the cover art and the tracklist in one frame.</figcaption>
          </figure>
        )}
      </section>

      <!-- The form -->
      <div class="fm-main">
        <!-- Success state -->
        <div class="fm-done" id="success-state" style="display:none" tabindex="-1" role="status">
          <h2 class="fm-done__title">Request received</h2>
          <p class="fm-done__body">
            We'll review your music and get back to you soon. Keep an eye on your inbox.
          </p>
          <a href="/metal-archive" class="btn btn--secondary">Back to the archive</a>
        </div>

        <form id="promo-form" class="fm-form" novalidate aria-labelledby="form-title">
          <h2 class="fm-title rise" id="form-title" style="--i:2">About your release</h2>
          <p class="fm-hint rise" style="--i:3">Fields marked * are required.</p>

          <!-- Band name + email -->
          <div class="fm-row rise" style="--i:4">
            <div class="fm-field">
              <label class="fm-label" for="band_name">Band name <span class="fm-req" aria-hidden="true">*</span></label>
              <input
                id="band_name" name="band_name" type="text"
                class="fm-input" placeholder="e.g. Blasfemia…" required
              />
            </div>
            <div class="fm-field">
              <label class="fm-label" for="email">Contact email <span class="fm-req" aria-hidden="true">*</span></label>
              <input
                id="email" name="email" type="email"
                class="fm-input" placeholder="band@email.com" autocomplete="email" spellcheck="false" required
              />
            </div>
          </div>

          <!-- Genre + Country -->
          <div class="fm-row rise" style="--i:5">
            <div class="fm-field">
              <label class="fm-label" for="genre">Genre <span class="fm-req" aria-hidden="true">*</span></label>
              <div class="fm-pick">
                <select id="genre" name="genre" class="fm-input" required>
                  <option value="">Pick a genre</option>
                  {GENRES.map(g => <option value={g}>{g}</option>)}
                  <option value="Other">Other...</option>
                </select>
                <svg class="fm-chev" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </div>
              <!-- Custom genre input — shown via JS when "Other" selected -->
              <input
                id="custom_genre" name="custom_genre" type="text" aria-label="Your genre"
                class="fm-input" placeholder="Type your genre…"
                style="display:none"
              />
            </div>
            <div class="fm-field">
              <label class="fm-label" for="country">Country</label>
              <input
                id="country" name="country" type="text"
                class="fm-input" placeholder="e.g. Honduras…"
              />
            </div>
          </div>

          <!-- Album title + Year -->
          <div class="fm-row rise" style="--i:6">
            <div class="fm-field">
              <label class="fm-label" for="album_title">Album title <span class="fm-req" aria-hidden="true">*</span></label>
              <input
                id="album_title" name="album_title" type="text"
                class="fm-input" placeholder="e.g. Inmaculada Concepcion…" required
              />
            </div>
            <div class="fm-field">
              <label class="fm-label" for="year">Release year</label>
              <input
                id="year" name="year" type="number" inputmode="numeric"
                class="fm-input" placeholder="e.g. 2024…" min="1960" max="2030"
              />
            </div>
          </div>

          {/* Package of interest — submitted as `release_format`, mapped to
              ContactMessage.package_interest. Hidden until PACKAGES_READY: with no
              real packages there is nothing to choose, so the select stays out. */}
          {PACKAGES_READY && (
          <div class="fm-field rise" style="--i:7">
            <label class="fm-label" for="release_format">Package of interest <span class="fm-hint-inline">(optional)</span></label>
            <div class="fm-pick">
              <select id="release_format" name="release_format" class="fm-input">
                <option value="">Pick a package (optional)</option>
                {PACKAGES.map(pkg => <option value={pkg.value}>{pkg.name}</option>)}
              </select>
              <svg class="fm-chev" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </div>
            <span class="fm-hint">Optional. You can also reach out without picking a package.</span>
          </div>
          )}

          <!-- Links section -->
          <fieldset class="fm-group rise" style="--i:8">
            <legend class="fm-label">Links <span class="fm-req" aria-hidden="true">*</span> <span class="fm-hint-inline">(at least one)</span></legend>

            <div class="fm-row">
              <div class="fm-field">
                <label class="fm-label" for="youtube_url">YouTube</label>
                <input
                  id="youtube_url" name="youtube_url" type="url"
                  class="fm-input" placeholder="https://youtu.be/…" spellcheck="false"
                />
              </div>
              <div class="fm-field">
                <label class="fm-label" for="bandcamp_url">Bandcamp / Spotify</label>
                <input
                  id="bandcamp_url" name="bandcamp_url" type="url"
                  class="fm-input" placeholder="https://band.bandcamp.com" spellcheck="false"
                />
              </div>
            </div>

            <!-- Dynamic extra links (up to 5) -->
            <div class="fm-extra" id="extra-links"></div>
            <button type="button" class="btn btn--secondary fm-add" id="add-link-btn">
              Add another link
            </button>
          </fieldset>

          <!-- Honeypot: invisible and unreachable for a real visitor. A bot
               that fills every field fills this one too, so the server can
               drop the submission silently. Never display:none -- some bots
               skip fields hidden that way. -->
          <input
            type="text" id="website" name="website" class="sr-only"
            tabindex="-1" autocomplete="off" aria-hidden="true"
          />

          <!-- Failure note -->
          <div class="fm-note" id="form-toast" role="alert" hidden></div>

          <div class="fm-actions rise" style="--i:9">
            <button type="submit" class="btn btn--primary fm-submit" id="submit-btn">
              Send request
            </button>
          </div>
        </form>
      </div>
    </div>

    <Carousel id="new" title="Recently added" albums={latest} href="/metal-archive/browse" hrefLabel="See all" />
  </main>

  <Footer />
</body>
</html>

<script>
  // Wrapped in astro:page-load so all handlers re-bind after client-side
  // navigation (with ClientRouter this <script> does not re-execute on swap).
  import { API_BASE, FORM_FETCH_TIMEOUT_MS, FORM_TIMEOUT_MESSAGE, isTimeoutError, timeoutSignal } from '../../lib/api.js';
  import { createFeedback, notSent, readFailure } from '../../components/form-feedback.js';

  function initPromoForm() {
    const form       = document.getElementById('promo-form') as HTMLFormElement | null;
    const btn        = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const toast      = document.getElementById('form-toast') as HTMLElement | null;
    const success    = document.getElementById('success-state') as HTMLElement | null;
    const genreEl    = document.getElementById('genre') as HTMLSelectElement | null;
    const customEl   = document.getElementById('custom_genre') as HTMLInputElement | null;
    const addLinkBtn = document.getElementById('add-link-btn') as HTMLButtonElement | null;
    const extraLinks = document.getElementById('extra-links') as HTMLElement | null;
    if (!form || !btn || !toast || !success || !genreEl || !customEl || !addLinkBtn || !extraLinks) return;
    if ((form as any).__bound) return;
    (form as any).__bound = true;

    // Failure note, inline field messages and the busy flag live in form-feedback.ts.
    const ui = createFeedback(form, toast);

    // Show/hide custom genre input
    genreEl.addEventListener('change', () => {
      customEl.style.display = genreEl.value === 'Other' ? 'block' : 'none';
      if (genreEl.value !== 'Other') customEl.value = '';
    });

    // Dynamic extra link rows (max 5)
    let linkCount = 0;
    addLinkBtn.addEventListener('click', () => {
      if (linkCount >= 5) return;
      const idx = linkCount++;
      const row = document.createElement('div');
      row.className = 'fm-extra__row';
      row.innerHTML = `
        <input type="url" name="extra_link_${idx}" class="fm-input" placeholder="https://…" aria-label="Extra link ${idx + 1}" spellcheck="false" />
        <button type="button" class="fm-remove" data-idx="${idx}" aria-label="Remove link ${idx + 1}">&times;</button>
      `;
      row.querySelector('.fm-remove')!.addEventListener('click', () => {
        row.remove();
        if (linkCount <= 5) addLinkBtn.style.display = '';
      });
      extraLinks.appendChild(row);
      if (linkCount >= 5) addLinkBtn.style.display = 'none';
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      ui.clear();

      const fd   = new FormData(form!);
      const data: Record<string, string> = {};
      fd.forEach((v, k) => { data[k] = String(v); });

      // Required field check — mark the FIRST empty required field.
      for (const field of ['band_name', 'email', 'album_title']) {
        if (!String(data[field] ?? '').trim()) {
          ui.fieldError(field, 'This field is required.');
          return;
        }
      }

      // At least one link — mark the first link field if none provided.
      const hasLink = ['youtube_url', 'bandcamp_url',
        'extra_link_0', 'extra_link_1', 'extra_link_2', 'extra_link_3', 'extra_link_4']
        .some(k => String(data[k] ?? '').trim());
      if (!hasLink) {
        ui.fieldError('youtube_url', 'Add at least one link.');
        return;
      }

      btn!.disabled = true;
      btn!.textContent = 'Sending...';
      ui.busy(true);

      try {
        const res = await fetch(`${API_BASE}/api/metal-archive/promo`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
          signal: timeoutSignal(FORM_FETCH_TIMEOUT_MS),
        });

        const json = await res.json().catch(() => ({}));

        if (res.ok) {
          form!.style.display = 'none';
          success!.style.display = 'flex';
          success!.focus();
        } else {
          ui.fail(readFailure(res.status, json));
        }
      } catch (err) {
        if (isTimeoutError(err)) {
          ui.fail(notSent(FORM_TIMEOUT_MESSAGE));
        } else {
          ui.fail(notSent('Could not connect. Check your internet connection.'));
        }
      } finally {
        btn!.disabled = false;
        btn!.textContent = 'Send request';
        ui.busy(false);
      }
    });
  }
  document.addEventListener('astro:page-load', initPromoForm);
</script>
