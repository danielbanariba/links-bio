---
// Metal Archive home: listen-first. A one-line heading, then rows of covers that
// play in place. Each row is a play queue: the ▶ on a card queues the cards of
// its own row (Carousel marks it data-queue) and the player goes on by itself.
import {
  getRecentAlbums,
  getMostPlayed,
  getGenreShowcases,
  getLiveRecordings,
  slugify,
} from '../../lib/db.js';
import { ClientRouter } from 'astro:transitions';
import { genreLabel } from '../../lib/labels.js';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Carousel from '../../components/Carousel.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import RowArrows from '../../components/RowArrows.astro';
import '../../styles/global.css';

// ─── Data queries (all build-time) ───────────────────────────────────────────
const ROW_SIZE = 12;
const latest         = getRecentAlbums(0, ROW_SIZE);   // id 0 excludes nothing
const mostPlayed     = getMostPlayed(ROW_SIZE);
const genreShowcases = getGenreShowcases(5);           // top 5 genres by album count
const liveRecordings = getLiveRecordings(ROW_SIZE);    // Daniel's own live sets
const ogImage = latest[0]?.thumb;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Metal Archive — Underground metal catalog</title>
    <meta name="description" content="The underground metal archive: death metal, brutal death, grindcore and more. Discover bands from all over the world." />
    <!-- OG / social meta -->
    <meta property="og:title" content="Metal Archive — Underground metal catalog" />
    <meta property="og:description" content="Underground metal catalog: death metal, brutal death, grindcore and more." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://danielbanariba.com/metal-archive" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Metal Archive" />
    <meta name="twitter:description" content="Underground metal archive." />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="canonical" href="https://danielbanariba.com/metal-archive" />
    <ClientRouter />
  </head>
  <body class="ma">
    <Navbar />

    <main id="main" tabindex="-1">
      <div class="wrap home-sections">
        <h1 class="home-title">Metal Archive</h1>
        <!-- Keeps the row titles (h3, from Carousel) nested under an h2. -->
        <h2 class="sr-only">Albums to play</h2>

        <Carousel title="Latest uploads" albums={latest} href="/metal-archive/browse" layout="scroll" />

        {mostPlayed.length > 0 && (
          <Carousel title="Most played" albums={mostPlayed} href="/metal-archive/browse?sort=views" layout="scroll" />
        )}

        <!-- One row per top genre; "See all" goes to that genre's page. -->
        {genreShowcases.map((showcase) => (
          <Carousel
            title={genreLabel(showcase.genre)}
            albums={showcase.albums}
            href={`/metal-archive/genre/${slugify(showcase.genre)}`}
            layout="scroll"
            deferred={true}
          />
        ))}

        <!-- Live recordings: Daniel's OWN live sets, in their own row. No "See all":
             there is no page for them. Written out here (not through Carousel)
             to keep the branded live cover, which Carousel has no prop for. -->
        {liveRecordings.length > 0 && (
          <section class="section carousel-deferred">
            <div class="section-header">
              <h3>Live recordings</h3>
              <div class="section-header__tools"><RowArrows title="Live recordings" /></div>
            </div>
            <div class="carousel-row" data-queue>
              {liveRecordings.map((a) => <AlbumCard album={a} loading="lazy" livePlaceholder={true} />)}
            </div>
          </section>
        )}
      </div>
    </main>

    <Footer />

    <script>
      // R3-003: the right-edge fade on .carousel-row is only wanted while scrolling
      // further right would actually reveal more content, so .has-scroll-fade is
      // toggled from the real scroll position. (The row arrows wire themselves: see
      // RowArrows.astro.) With ClientRouter this <script> does not re-execute on
      // navigation, so the init runs on astro:page-load (which fires on the first
      // load too); a per-row guard avoids re-binding.
      (function () {
        function updateRow(row: Element) {
          var max = row.scrollWidth - row.clientWidth;
          row.classList.toggle('has-scroll-fade', max - row.scrollLeft > 1);
        }
        function initScrollFade() {
          var rows = document.querySelectorAll('.carousel-row');
          rows.forEach(function (row) {
            updateRow(row);
            if ((row as any).__fadeBound) return;
            (row as any).__fadeBound = true;
            row.addEventListener('scroll', function () { updateRow(row); }, { passive: true });
          });
        }
        window.addEventListener('resize', function () {
          document.querySelectorAll('.carousel-row').forEach(updateRow);
        });
        document.addEventListener('astro:page-load', initScrollFade);
        initScrollFade();   // a navigation can run this script after astro:page-load has fired
      })();
    </script>
  </body>
</html>
