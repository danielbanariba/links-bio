---
// newsletter.astro — Metal Archive newsletter signup
// POSTs to /api/metal-archive/newsletter (FastAPI on port 8001, proxied by host)
//
// The dark room (premium redesign, 2026): the shared head, then two columns on a desktop, what
// the letter is about and the archive's real numbers on the left and the one field on the right;
// on a phone the argument comes first. What the letter reports is on the shelf under it: the
// latest additions.
import { ClientRouter } from 'astro:transitions';
import { getLatestUploads } from '../../lib/db.js';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ArchiveHead from '../../components/ArchiveHead.astro';
import PageHead from '../../components/PageHead.astro';
import Reveal from '../../components/Reveal.astro';
import Carousel from '../../components/Carousel.astro';
import FormFacts from '../../components/FormFacts.astro';
import '../../styles/global.css';

const latest = getLatestUploads(8);

// The field of the head: a warm neutral, mixed down into the ground by PageHead (as Browse).
const HEAD_COLOR = '#8c8478';

const pageTitle = 'Newsletter | Metal Archive';
const metaDesc = 'Subscribe for news about new albums, bands and underground metal events.';
const canonical = 'https://danielbanariba.com/metal-archive/newsletter';
const ogImage = 'https://danielbanariba.com/avatar.jpg';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDesc} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDesc} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDesc} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="canonical" href={canonical} />
  <ArchiveHead />
  <ClientRouter />
</head>
<body class="ma">
  <Reveal />
  <Navbar />

  <main id="main" tabindex="-1">
    <PageHead title="Newsletter" color={HEAD_COLOR} split>
      <p class="page-head__lead rise" style="--i:1">Subscribe for news about new albums, bands and underground metal events.</p>
      <a class="btn btn--secondary fm-jump rise" style="--i:2" href="#form-title">Go to the form</a>
    </PageHead>

    <div class="fm">
      <!-- The argument: what the letter is about, and the archive it reports on -->
      <section class="fm-aside" data-reveal aria-labelledby="about-title">
        <h2 class="fm-title rv" id="about-title" style="--i:0">What you'll get</h2>
        <ul class="fm-list rv" style="--i:1">
          <li>New albums</li>
          <li>New bands</li>
          <li>Underground metal events</li>
        </ul>
        <div class="rv" style="--i:2">
          <FormFacts lead="News from an archive of" />
        </div>
      </section>

      <!-- The form -->
      <div class="fm-main">
        <!-- Success state -->
        <div class="fm-done" id="success-state" style="display:none" tabindex="-1" role="status">
          <h2 class="fm-done__title">You're subscribed</h2>
          <p class="fm-done__body">
            Welcome to the archive. We'll let you know when there's news from the underground.
          </p>
          <a href="/metal-archive" class="btn btn--secondary">Back to the archive</a>
        </div>

        <form id="newsletter-form" class="fm-form" novalidate aria-labelledby="form-title">
          <h2 class="fm-title rise" id="form-title" style="--i:2">Your email</h2>

          <div class="fm-field rise" style="--i:3">
            <label class="fm-label" for="email">Email address <span class="fm-req" aria-hidden="true">*</span></label>
            <input
              id="email" name="email" type="email"
              class="fm-input" placeholder="you@email.com"
              autocomplete="email" spellcheck="false" required
            />
          </div>

          <!-- Honeypot: invisible and unreachable for a real visitor. A bot
               that fills every field fills this one too, so the server can
               drop the submission silently. Never display:none -- some bots
               skip fields hidden that way. -->
          <input
            type="text" id="website" name="website" class="sr-only"
            tabindex="-1" autocomplete="off" aria-hidden="true"
          />

          <!-- Failure note -->
          <div class="fm-note" id="form-toast" role="alert" hidden></div>

          <div class="fm-actions rise" style="--i:4">
            <button type="submit" class="btn btn--primary fm-submit" id="submit-btn">
              Subscribe
            </button>
          </div>
        </form>
      </div>
    </div>

    <Carousel id="new" title="Recently added" albums={latest} href="/metal-archive/browse" hrefLabel="See all" />
  </main>

  <Footer />
</body>
</html>

<script>
  // Wrapped in astro:page-load so the form handler re-binds after client-side
  // navigation (with ClientRouter this <script> does not re-execute on swap).
  import { API_BASE, FORM_FETCH_TIMEOUT_MS, FORM_TIMEOUT_MESSAGE, isTimeoutError, timeoutSignal } from '../../lib/api.js';
  import { createFeedback, notSent, readFailure } from '../../components/form-feedback.js';

  function initNewsletterForm() {
    const form    = document.getElementById('newsletter-form') as HTMLFormElement | null;
    const btn     = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const toast   = document.getElementById('form-toast') as HTMLElement | null;
    const success = document.getElementById('success-state') as HTMLElement | null;
    if (!form || !btn || !toast || !success || (form as any).__bound) return;
    (form as any).__bound = true;

    // Failure note, inline field messages and the busy flag live in form-feedback.ts.
    const ui = createFeedback(form, toast);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      ui.clear();

      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      // Honeypot: real visitors never see or fill this field; a bot that
      // fills every field fills this one too, and the server drops the
      // submission silently while still answering with success.
      const website = (document.getElementById('website') as HTMLInputElement | null)?.value ?? '';

      if (!email || !email.includes('@')) {
        ui.fieldError('email', 'Enter a valid email address, like you@email.com.');
        return;
      }

      btn!.disabled = true;
      btn!.textContent = 'Subscribing...';
      ui.busy(true);

      try {
        const res = await fetch(`${API_BASE}/api/metal-archive/newsletter`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, website }),
          signal: timeoutSignal(FORM_FETCH_TIMEOUT_MS),
        });

        const json = await res.json().catch(() => ({}));

        if (res.ok) {
          form!.style.display = 'none';
          success!.style.display = 'flex';
          success!.focus();
        } else {
          // 409 (already subscribed) is a calm note, not an error; see readFailure.
          ui.fail(readFailure(res.status, json, 'newsletter'));
        }
      } catch (err) {
        if (isTimeoutError(err)) {
          ui.fail(notSent(FORM_TIMEOUT_MESSAGE));
        } else {
          ui.fail(notSent('Could not connect. Check your internet connection.'));
        }
      } finally {
        btn!.disabled = false;
        btn!.textContent = 'Subscribe';
        ui.busy(false);
      }
    });
  }
  document.addEventListener('astro:page-load', initNewsletterForm);
</script>
