---
// Same slug strategy as genre: country names contain spaces (e.g. "Estados Unidos",
// "Reino Unido"). Slugify to URL-safe string; real value travels as prop.
//
// The database stores country names in SPANISH, so the slug — and therefore the
// public URL — stays Spanish (/country/estados-unidos) and no existing link
// breaks. The flag and the English label both come from lib/labels.ts, which
// replaced the ~95-entry flag map that used to be duplicated here and on the
// archive home page.
import { ClientRouter } from 'astro:transitions';
import { getAllCountries, getAlbumsByCountry, getFacetLead, slugify } from '../../../lib/db.js';
import { countryFlag, countryLabel } from '../../../lib/labels.js';
import { getAlbumColor } from '../../../lib/vibrant.js';
import FacetMain from '../../../components/FacetMain.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import ArchiveHead from '../../../components/ArchiveHead.astro';
import Reveal from '../../../components/Reveal.astro';
import '../../../styles/global.css';

// slugify is imported from db.ts — single source of truth shared with the pages
// that link here. Imports are available in the prerender chunk.
export function getStaticPaths() {
  const countries = getAllCountries();
  return countries.map((facet) => ({
    params: { country: slugify(facet.value) },
    props: { realCountry: facet.value },
  }));
}

interface Props {
  realCountry: string;
}

const { realCountry } = Astro.props;
// NOT_LIVE applied inside getAlbumsByCountry; derive the count from the same
// list so the header number and the grid agree (comparable to Browse).
const albums = getAlbumsByCountry(realCountry);
const count = albums.length;
const flag = countryFlag(realCountry);
const label = countryLabel(realCountry);

// The page leads with the country's most played record; its cover sets the header colour.
// With no views anywhere in the country the newest upload stands in.
const lead = getFacetLead('country', [realCountry]);
const repCover = lead ?? albums[0] ?? null;
const countryColor = repCover ? await getAlbumColor(repCover.thumb, repCover.cover) : '';
const nf = new Intl.NumberFormat('en-US');
const sentence = `${nf.format(count)} ${count === 1 ? 'album' : 'albums'} from ${label}, newest upload first.`;

// Chain to Browse with this country pre-applied. Search restores from the exact
// value (e.country === country), so the URL carries the REAL country, not the slug.
const browseHref = `/metal-archive/browse?country=${encodeURIComponent(realCountry)}`;

const pageTitle = `${label} — Metal Archive`;
const metaDesc = `${count} ${count === 1 ? 'album' : 'albums'} from ${label} in the Metal Archive.`;
const canonical = `https://danielbanariba.com/metal-archive/country/${slugify(realCountry)}`;
const ogImage = albums[0]?.thumb || undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDesc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="canonical" href={canonical} />
    <ArchiveHead />
    <ClientRouter />
  </head>
  <body class="ma">
    <Reveal />
    <Navbar />

    <FacetMain
      title={label}
      flag={flag}
      sentence={sentence}
      browseHref={browseHref}
      albums={albums}
      lead={lead}
      leadKind={`Most played from ${label}`}
      color={countryColor}
      empty="No albums from this country yet."
    />

    <Footer cover={(lead ?? albums[0])?.cover || undefined} />
  </body>
</html>
