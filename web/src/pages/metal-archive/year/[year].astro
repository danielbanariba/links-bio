---
// Year values are integers — no slug transform needed.
// year param is a string in the URL; convert to number for DB query.
import { ClientRouter } from 'astro:transitions';
import { getAllYears, getAlbumsByYear } from '../../../lib/db.js';
import { tileColor } from '../../../lib/tiles.js';
import AlbumGrid from '../../../components/AlbumGrid.astro';
import FacetBanner from '../../../components/FacetBanner.astro';
import ArchiveChrome from '../../../components/ArchiveChrome.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/global.css';
import '../../../styles/archive.css';

export function getStaticPaths() {
  const years = getAllYears();
  return years.map((facet) => ({
    params: { year: String(facet.value) },
    props: { year: facet.value as number },
  }));
}

interface Props {
  year: number;
}

const { year } = Astro.props;
// NOT_LIVE applied inside getAlbumsByYear; derive the count from the same list
// so the header number and the grid agree (comparable to Browse).
const albums = getAlbumsByYear(year);
const count = albums.length;

// Years have no tiles; the year picks a colour from the same palette, so
// neighbouring years differ and a year keeps its colour from build to build.
const bannerColor = tileColor('genre', year);

const pageTitle = `${year} — Metal Archive`;
const metaDesc = `${count} ${count === 1 ? 'album' : 'albums'} from ${year} in the Metal Archive.`;
const canonical = `https://danielbanariba.com/metal-archive/year/${year}`;
const ogImage = albums[0]?.thumb || undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDesc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="canonical" href={canonical} />
    <ClientRouter />
  </head>
  <body class="ma-shell">
    <ArchiveChrome />

    <main class="ma-facetpage" id="main" tabindex="-1">
      <FacetBanner name={String(year)} count={count} color={bannerColor} />
      {albums.length > 0
        ? <AlbumGrid albums={albums} />
        : <p class="ma-muted">No albums from this year yet.</p>
      }
    </main>

    <Footer />
  </body>
</html>
