---
// Year values are integers — no slug transform needed.
// year param is a string in the URL; convert to number for DB query.
import { ClientRouter } from 'astro:transitions';
import { getAllYears, getAlbumsByYear, getFacetLead } from '../../../lib/db.js';
import { getAlbumColor } from '../../../lib/vibrant.js';
import FacetMain from '../../../components/FacetMain.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import ArchiveHead from '../../../components/ArchiveHead.astro';
import Reveal from '../../../components/Reveal.astro';
import '../../../styles/global.css';

export function getStaticPaths() {
  const years = getAllYears();
  return years.map((facet) => ({
    params: { year: String(facet.value) },
    props: { year: facet.value as number },
  }));
}

interface Props {
  year: number;
}

const { year } = Astro.props;
// NOT_LIVE applied inside getAlbumsByYear; derive the count from the same list
// so the header number and the grid agree (comparable to Browse).
const albums = getAlbumsByYear(year);
const count = albums.length;

// The page leads with the year's most played record; its cover sets the header colour. With
// no views anywhere in the year the newest upload stands in. Year 0 is the DB's "unknown".
const lead = getFacetLead('year', [year]);
const repCover = lead ?? albums[0] ?? null;
const yearColor = repCover ? await getAlbumColor(repCover.thumb, repCover.cover) : '';
const nf = new Intl.NumberFormat('en-US');
const title = year ? String(year) : 'Year unknown';
const sentence = year
  ? `${nf.format(count)} ${count === 1 ? 'album' : 'albums'} released in ${year}, newest upload first.`
  : `${nf.format(count)} ${count === 1 ? 'album' : 'albums'} with no release year on record, newest upload first.`;

// Chain to Browse with this year pre-applied. Search restores from the exact
// value (String(e.year) === year), so the URL carries the REAL year.
const browseHref = `/metal-archive/browse?year=${encodeURIComponent(String(year))}`;

const pageTitle = `${year} — Metal Archive`;
const metaDesc = `${count} ${count === 1 ? 'album' : 'albums'} from ${year} in the Metal Archive.`;
const canonical = `https://danielbanariba.com/metal-archive/year/${year}`;
const ogImage = albums[0]?.thumb || undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDesc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="canonical" href={canonical} />
    <ArchiveHead />
    <ClientRouter />
  </head>
  <body class="ma">
    <Reveal />
    <Navbar />

    <FacetMain
      title={title}
      sentence={sentence}
      browseHref={browseHref}
      albums={albums}
      lead={lead}
      leadKind={year ? `Most played of ${year}` : 'Most played'}
      color={yearColor}
      empty="No albums from this year yet."
    />

    <Footer cover={(lead ?? albums[0])?.cover || undefined} />
  </body>
</html>
