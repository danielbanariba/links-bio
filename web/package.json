{
  "name": "metal-archive-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "covers": "node scripts/covers/covers.mjs",
    "build": "npm run covers && astro build && node scripts/apply-vercel-headers.mjs",
    "preview": "astro preview",
    "test": "node --import ./tests/support/register.mjs --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "@astrojs/vercel": "^11.0.16",
    "astro": "^7.4.2",
    "better-sqlite3": "^13.0.3",
    "preact": "^11.0.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    }
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "sharp": false
  }
}
